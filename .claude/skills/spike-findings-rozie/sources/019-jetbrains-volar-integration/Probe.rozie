<rozie>
<props>
{
  label:    { type: String,  default: 'Click me' },
  count:    { type: Number,  default: 0 },
  disabled: { type: Boolean, default: false },
}
</props>

<data>
{ clicks: 0, lastLabel: '' }
</data>

<script>
function bump() {
  $data.clicks = $data.clicks + 1;
  $data.lastLabel = $props.label;
}
</script>

<template>
  <button @click="bump()" :disabled="$props.disabled">
    {{ $props.label }} ({{ $data.clicks }})
  </button>
</template>
</rozie>
