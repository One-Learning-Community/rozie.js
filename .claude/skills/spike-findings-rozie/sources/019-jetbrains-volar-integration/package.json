{
  "name": "spike-019-rozie-volar-language-server",
  "private": true,
  "type": "module",
  "description": "Spike 019 — a real Volar-based LSP server for .rozie, consumed by the IntelliJ native platform LSP API. Standalone; NOT a pnpm workspace member.",
