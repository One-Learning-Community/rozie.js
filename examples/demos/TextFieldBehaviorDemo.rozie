<!--
  TextFieldBehaviorDemo — VR behavioral cell for @rozie-ui/text-field (pure-Rozie,
  no engine). Proves the field wiring on all six targets, Lit's shadow root
  included: the label labels the control (getByLabel / label click focuses it),
  aria-describedby tracks the rendered description / error / counter, the two-way
  modelValue + change / enter events, a programmatic model write, the
  clear() / focus() handle, and multiline autosize. See text-field.spec.ts.
  Behavioral-only.
-->
<rozie name="TextFieldBehaviorDemo">

<components>
{
  TextField: '../../packages/ui/text-field/src/TextField.rozie',
}
</components>

<data>
{
  email: '',
  notes: '',
  emailError: '',
  lastChange: '',
  lastEnter: '',
}
</data>

<script>
const onChange = (p) => {
  $data.lastChange = p && p.value != null ? String(p.value) : 'null'
}
const onEnter = (p) => {
  $data.lastEnter = p && p.value != null ? String(p.value) : 'null'
}
const toggleError = () => {
  $data.emailError = $data.emailError ? '' : 'Enter a valid email address.'
}
const applyEmail = () => {
  $data.email = 'ada@example.com'
}
const applyNotes = () => {
  $data.notes = 'one\ntwo\nthree\nfour\nfive\nsix\nseven'
}
const clearEmail = () => {
  $refs.emailField.clear()
}
const focusEmail = () => {
  $refs.emailField.focus()
}
</script>

<template>
<div class="text-field-demo">
  <h3>TextField — behavioral</h3>

  <div class="controls">
    <button type="button" data-testid="toggle-error" @click="toggleError()">Toggle error</button>
    <button type="button" data-testid="set-email" @click="applyEmail()">Set email</button>
    <button type="button" data-testid="clear-email" @click="clearEmail()">clear()</button>
    <button type="button" data-testid="focus-email" @click="focusEmail()">focus()</button>
    <button type="button" data-testid="set-notes" @click="applyNotes()">Set notes</button>
  </div>
  <div class="controls">
    <span class="readout" data-testid="readout-value">{{ $data.email }}</span>
    <span class="readout" data-testid="readout-change">{{ $data.lastChange }}</span>
    <span class="readout" data-testid="readout-enter">{{ $data.lastEnter }}</span>
    <span class="readout" data-testid="readout-notes">{{ $data.notes.length }}</span>
  </div>

  <TextField
    ref="emailField"
    r-model:modelValue="$data.email"
    label="Email"
    type="email"
    idBase="demo-email"
    description="We never share it."
    :error="$data.emailError"
    :maxLength="40"
    showCount
    required
    @change="onChange($event)"
    @enter="onEnter($event)"
  />

  <TextField
    r-model:modelValue="$data.notes"
    label="Notes"
    multiline
    autosize
    :rows="2"
    :maxRows="4"
  />
</div>
</template>

<style>
.text-field-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 360px;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.text-field-demo .controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}
.text-field-demo .readout {
  font-variant-numeric: tabular-nums;
  min-width: 3ch;
}
</style>

</rozie>
