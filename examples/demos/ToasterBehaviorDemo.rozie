<!--
  ToasterBehaviorDemo — VR behavioral cell for @rozie-ui/toast (pure-Rozie, no
  engine). Drives the imperative handle: a `show-toast` button calls
  $refs.toaster.show({...}) (the $expose handle resolves on all 6 targets) and
  bumps a count readout; toasts are sticky (:duration="0") so the spec can assert
  the rendered toast + its close button, then dismiss it. See toaster.spec.ts.

  Also drives swipe-to-dismiss (TOAST-SWIPE): the SAME `Toaster` instance sits
  in its default `top-right` corner (dismiss direction = right), so a
  `show-toast`-enqueued sticky toast is a stable, always-present target the
  Playwright drag can grab. A `dismissed-reason` readout mirrors the LATEST
  `@dismissed` event's `reason` (proves 'swipe' fires, distinct from 'close'/
  'api'/'timeout'); a `toggle-disable-swipe` button flips the `disableSwipe`
  prop so the spec can assert swipe goes inert.

  Also drives stacked mode (TOAST-STACK): a `toggle-stacked` button flips the
  `stacked` prop; the spec queues several `show-toast` clicks then toggles
  `stacked` on to assert the collapsed depth-driven grid overlay (depth>=3
  hidden) and its hover-triggered expand. Behavioral-only (no pixel baseline
  here) — stacked's own pixel proof is the ToasterStackedScreenshot cell.

  quick 260926-i1f — `show-short-action-toast` drives the keyboard-focus-pause
  a11y VR battery: a SHORT (`:duration="900"`) toast carrying an action button,
  so the spec can focus the action via keyboard, wait past the duration, and
  assert the timer stayed paused (WCAG 2.2.1), then blur/leave and assert it
  resumes + dismisses.
-->
<rozie name="ToasterBehaviorDemo">

<components>
{
  Toaster: '../../packages/ui/toast/src/Toaster.rozie',
}
</components>

<data>
{
  count: 0,
  disableSwipe: false,
  stacked: false,
  dismissedReason: '',
  actionResult: '',
}
</data>

<script>
const showToast = () => {
  const n = $data.count + 1
  $data.count = n
  $refs.toaster.show({ message: 'Saved ' + n, type: 'success' })
}
// quick 261008-mmu — an ERROR toast, routed to the assertive live region.
const showErrorToast = () => {
  $refs.toaster.show({ message: 'Upload failed', type: 'error' })
}
// quick 260925-rb6 — a toast carrying an action + pass-through data.
const showActionToast = () => {
  $refs.toaster.show({
    message: 'Conversation archived',
    data: { threadId: 't42' },
    action: { label: 'Undo', onClick: (ctx) => { $data.actionResult = 'undo ' + ctx.data.threadId } },
  })
}
// quick 260926-i1f — a SHORT-duration action toast for the keyboard-focus-pause
// (WCAG 2.2.1) VR battery: long enough to reliably render + focus, short enough
// that "well past the duration" is a fast, non-flaky wait.
const showShortActionToast = () => {
  $refs.toaster.show({
    message: 'Short-lived',
    duration: 900,
    action: { label: 'Act', onClick: () => {} },
  })
}
const toggleDisableSwipe = () => {
  $data.disableSwipe = !$data.disableSwipe
}
const toggleStacked = () => {
  $data.stacked = !$data.stacked
}
const onDismissed = (payload) => {
  $data.dismissedReason = payload.reason
}
</script>

<template>
<div class="toast-demo">
  <h3>Toast — behavioral</h3>

  <div class="controls">
    <button type="button" data-testid="show-toast" @click="showToast()">Show toast</button>
    <span class="readout" data-testid="readout-count">{{ $data.count }}</span>
    <button type="button" data-testid="toggle-disable-swipe" @click="toggleDisableSwipe()">Toggle disableSwipe</button>
    <button type="button" data-testid="toggle-stacked" @click="toggleStacked()">Toggle stacked</button>
    <span class="readout" data-testid="dismissed-reason">{{ $data.dismissedReason }}</span>
    <button type="button" data-testid="show-error-toast" @click="showErrorToast()">Show error toast</button>
    <button type="button" data-testid="show-action-toast" @click="showActionToast()">Show action toast</button>
    <span class="readout" data-testid="action-result">{{ $data.actionResult }}</span>
    <button type="button" data-testid="show-short-action-toast" @click="showShortActionToast()">Show short action toast</button>
  </div>

  <Toaster
    ref="toaster"
    position="top-right"
    :duration="0"
    ariaLabel="Notifications"
    :disable-swipe="$data.disableSwipe"
    :stacked="$data.stacked"
    @dismissed="onDismissed"
  />
</div>
</template>

<style>
.toast-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 360px;
}
.toast-demo .controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.toast-demo .readout {
  min-width: 2ch;
  font-variant-numeric: tabular-nums;
}
</style>

</rozie>
