<!--
  DialogNestedScrollLockDemo — VR behavioral cell for @rozie-ui/dialog's
  ref-counted `<html>` scroll lock. An OUTER Dialog contains an INNER Dialog
  (composition — the inner is nested inside the outer's default slot, exactly
  like a confirm-dialog-inside-a-form-dialog pattern a real consumer would
  hit). Both use the default `disableScrollLock: false`, so both participate in
  the shared, ref-counted lock (packages/ui/dialog/src/internal/scrollLock.ts).

  The bug this guards: BEFORE ref-counting, `applyScrollLock` was a naive
  per-instance toggle — closing the INNER dialog while the OUTER one was still
  open unlocked `<html>` scrolling entirely, even though the outer dialog (and
  its own scroll-lock requirement) was still on screen. See dialog.spec.ts for
  the sibling open/close/Escape/handle spec; this demo is scroll-lock-specific.
-->
<rozie name="DialogNestedScrollLockDemo">

<components>
{
  Dialog: '../../packages/ui/dialog/src/Dialog.rozie',
}
</components>

<data>
{
  outerOpen: false,
  innerOpen: false,
}
</data>

<script>
const openOuter = () => {
  $data.outerOpen = true
}
const closeOuter = () => {
  $data.outerOpen = false
}
const openInner = () => {
  $data.innerOpen = true
}
const closeInner = () => {
  $data.innerOpen = false
}
</script>

<template>
<div class="nested-dialog-demo">
  <h3>Dialog — nested scroll-lock</h3>

  <div class="controls">
    <button type="button" data-testid="open-outer" @click="openOuter()">Open outer</button>
    <span class="readout" data-testid="readout-outer-open">{{ String($data.outerOpen) }}</span>
    <span class="readout" data-testid="readout-inner-open">{{ String($data.innerOpen) }}</span>
  </div>

  <Dialog r-model:open="$data.outerOpen" ariaLabel="Outer dialog">
    <h2>Outer</h2>
    <p data-testid="outer-body">Outer content</p>
    <button type="button" data-testid="open-inner" @click="openInner()">Open inner</button>
    <button type="button" data-testid="close-outer" @click="closeOuter()">Close outer</button>

    <Dialog r-model:open="$data.innerOpen" ariaLabel="Inner dialog">
      <h2>Inner</h2>
      <p data-testid="inner-body">Inner content</p>
      <button type="button" data-testid="close-inner" @click="closeInner()">Close inner</button>
    </Dialog>
  </Dialog>
</div>
</template>

<style>
.nested-dialog-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 360px;
}
.nested-dialog-demo .controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.nested-dialog-demo .readout {
  min-width: 4ch;
}
</style>

</rozie>
