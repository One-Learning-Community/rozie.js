<!--
  AutoIdPopoverDemo.rozie — BEHAVIORAL cell for the per-instance default id base
  (oinbox 0.8.0 follow-up F6, quick 261002-ekf): two default-configured Popovers
  (keepMounted, so both panels render without a gesture) must never share an id.
  The Select half of the same check is AutoIdDemo.rozie (see its header for why
  the two are separate pages). Driven by
  tests/visual-regression/specs/auto-id.spec.ts on all 6 targets.
  Behavioral-only — no pixel baseline.
-->

<rozie name="AutoIdPopoverDemo">

<components>
{
  Popover: '../../packages/ui/popover/src/Popover.rozie',
}
</components>

<template>
<div class="auto-id-popover-demo">
  <Popover keepMounted>
    <template #anchor><button type="button">Popover A</button></template>
    <p>Panel A</p>
  </Popover>
  <Popover keepMounted>
    <template #anchor><button type="button">Popover B</button></template>
    <p>Panel B</p>
  </Popover>
</div>
</template>

<style>
.auto-id-popover-demo {
  font-family: system-ui, -apple-system, sans-serif;
  padding: 1rem;
  display: flex;
  gap: 1rem;
  min-height: 200px;
}
</style>

</rozie>
