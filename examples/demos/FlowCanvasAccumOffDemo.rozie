<!--
  FlowCanvasAccumOffDemo.rozie — the accumulate-OFF half of the quick-260803-uwb
  `accumulateOnCtrl` cell. A minimal twin of FlowCanvasVerbsDemo with the ONE difference
  that matters: `:accumulate-on-ctrl="false"`.

  WHY A SECOND MOUNT RATHER THAN A TOGGLE BUTTON: `accumulateOnCtrl` is CONSTRUCTION-TIME.
  It is consumed exactly once, in `$onMount`, at

      AreaExtensions.selectableNodes(area, selector, {
        accumulating: $props.accumulateOnCtrl ? AreaExtensions.accumulateOnCtrl() : { active: () => false },
      })

  (FlowCanvas.rozie:2278-2282, whose own comment says "`accumulateOnCtrl` stays
  construction-time — it is not one of the five live props"). Flipping it after mount is a
  no-op BY DESIGN, so the only honest way to cover the false branch is a separate mount.
  The spec cell therefore does two `page.goto`s in ONE test (the shipped NodeToolbar-cell
  precedent, rete-flow.spec.ts:2016/:2069) rather than an `r-if` remount, which would drag
  full engine teardown/re-init across 6 targets into a coverage task.

  With accumulation off, a Ctrl/Cmd-click must still PICK the node — it simply REPLACES the
  selection instead of adding to it. That is the load-bearing half: a bare `selected-count`
  of '1' would also pass if the modified click were vetoed outright, so the spec additionally
  asserts the `.is-selected` box is the SECOND node's.

  Same 3-node / 1-edge graph and the same `:fit-on-mount="false"` fixed seeding as
  FlowCanvasVerbsDemo so the two halves of the cell click identical geometry. No verb
  buttons — this demo exists for exactly one gesture.

  Container needs explicit height/width (the VR host mounts at max-content).
-->

<rozie name="FlowCanvasAccumOffDemo">

<components>
{
  FlowCanvas: '../../packages/ui/rete/src/FlowCanvas.rozie',
  NodeType:   '../../packages/ui/rete/src/NodeType.rozie',
  Port:       '../../packages/ui/rete/src/Port.rozie',
}
</components>

<data>
{
  // settled selected-node count (from @selection-change) — the whole assertion surface.
  selectedCount: 0,
  // identical seeding to FlowCanvasVerbsDemo so both halves of the accumulate cell click
  // the same geometry.
  graph: {
    nodes: [
      { id: 'a', type: 'task', x: 40,  y: 40,  data: { label: 'Alpha' } },
      { id: 'b', type: 'task', x: 40,  y: 190, data: { label: 'Bravo' } },
      { id: 'c', type: 'task', x: 420, y: 40,  data: { label: 'Charlie' } },
    ],
    connections: [
      { id: 'ab', source: 'a', sourceOutput: 'out', target: 'b', targetInput: 'in' },
    ],
  },
}
</data>

<script>
// @selection-change surfaces the selected node id set ({ ids }) — record the SETTLED count.
const onSelectionChange = (e) => {
  $data.selectedCount = e && Array.isArray(e.ids) ? e.ids.length : 0
}
</script>

<template>
<div class="flow-demo">
  <h3>FlowCanvas — accumulateOnCtrl = false (behavioral)</h3>

  <div class="controls">
    <span class="readout" data-testid="node-count">{{ $data.graph.nodes.length }}</span>
    <span class="readout" data-testid="conn-count">{{ $data.graph.connections.length }}</span>
    <span class="readout" data-testid="selected-count">{{ $data.selectedCount }}</span>
  </div>

  <div class="flow-wrap" style="height: 400px; width: 760px">
    <FlowCanvas
      ref="canvas"
      r-model:graph="$data.graph"
      :accumulate-on-ctrl="false"
      :fit-on-mount="false"
      @selection-change="onSelectionChange"
    >
      <NodeType type="task">
        <template #body="{ node }">
          <div class="rozie-demo-node">
            <strong>{{ node.data.label }}</strong>
          </div>
        </template>
        <Port input="in" label="in" multiple />
        <Port output="out" label="out" />
      </NodeType>
    </FlowCanvas>
  </div>
</div>
</template>

<style>
.flow-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  max-width: 800px;
}
.flow-demo h3 { margin: 0 0 0.75rem; font-size: 1rem; }
.controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
  flex-wrap: wrap;
}
.controls .readout {
  font-variant-numeric: tabular-nums;
  font-size: 0.875rem;
  min-width: 2ch;
}

:root {
  /* the #body chrome teleports into the engine node element inside the canvas shadow
     root, so on Lit a plain scoped rule cannot reach it — :root emits document-level
     CSS adopted into the shadow root. NOT :global() (ROZ128 hard error). */
  .rozie-flow-canvas .rozie-demo-node {
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: #111827;
    white-space: nowrap;
  }
}
</style>

</rozie>
