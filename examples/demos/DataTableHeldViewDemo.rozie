<!--
  DataTableHeldViewDemo.rozie — data-table held-view / per-column filterFn+sortingFn fixture.

  Drives data-table-held-view.spec.ts across all six targets. ONE grid-mode, `undoable`,
  r-model:data DataTable (ref="dt", data-testid="grid-table") with CONTROLLED columnFilters
  and sorting in $data, over 6 rows { id, title, grades[], labels[], owner, minQty }.

  Columns: id (read-only, first — the spec reads visible ids from each body row's first
  cell), title (editable text, sortable, filterable), grades (filterable, custom list rule
  gradesRule), labels (filterable, filterFn="arrIncludesSome"), owner (editable text,
  filterable, filterFn="equalsString"), minQty (filterable, closure filterFn reading
  $data.threshold).

  Held view (Task 4): `:holdView="$data.hold"` (true until the hold-off button), r-model:pagination (pageSize 10 → all 6 rows; the
  next-page button switches to pageSize 3 and advances), a `selectionMode` driven from $data
  ('none' until selection-on, so the default layout has no checkbox column), and readouts
  `view-state` (JSON of the last view-state-change payload) + `selected-count`.

  Verb buttons drive the live $refs.dt handle (never cached), each guarded so the demo still
  compiles before a verb exists.

  Active-cell follow (Task 5): a SECOND grid-mode DataTable (data-testid="grid-live") with
  holdView OFF over its own copy of the rows (r-model:data → rowsLive, readout
  `model-readout-live`), its own controlled sorting/columnFilters, and `sort-title-live` /
  `filter-owner-dana-live` buttons.

  A THIRD grid (data-testid="grid-oneway") binds `:data` ONE-WAY (no r-model): its own writes
  are never echoed back, and `swap-oneway` replaces the dataset with fresh rows lacking id 1 —
  an external swap that must keep the D-05 clamp fallback on all six targets. No loop var / slot param named row/cell/header (Svelte
  mount-throw discipline) — the #cell slot binds value only.

  Final-review wave:
  - `page-readout` shows the grid-table's pagination model (a table write / refreshView must
    never turn the page; a sort/filter change goes to page 1).
  - grid-live gains `filter-owner-fay-live` (one row) and `filter-title-a-live` (four rows).
  - grid-tmode: a 'table'-mode DataTable (ref dtT) whose editor is opened by the editCell verb.
  - grid-cfg: a `:columns` CONFIG DataTable carrying filterFn / sortingFn (the buildConfigDef
    path), driven by its own controlled filters/sorting.
  - grid-oneway-noid: a one-way, title-desc-sorted grid WITHOUT getRowId; `swap-noid` swaps
    its dataset (an external swap must clamp, not follow index-ids to another record).
-->

<rozie name="DataTableHeldViewDemo">

<components>
{
  DataTable: '../../packages/ui/data-table/src/DataTable.rozie',
  Column: '../../packages/ui/data-table/src/Column.rozie',
}
</components>

<data>
{
  rows: [
    { id: 1, title: 'Alpha',   grades: [1, 2], labels: ['a'],      owner: 'Dana', minQty: 1 },
    { id: 2, title: 'Beta',    grades: [3],    labels: ['x', 'b', 'y'], owner: 'Eli',  minQty: 3 },
    { id: 3, title: 'Gamma',   grades: [],     labels: ['c'],      owner: 'Fay',  minQty: 5 },
    { id: 4, title: 'Delta',   grades: [2, 4], labels: ['d', 'd2'],      owner: 'Dana', minQty: 8 },
    { id: 5, title: 'Epsilon', grades: [5],    labels: ['x'],      owner: 'Gus',  minQty: 2 },
    { id: 6, title: 'Zed',     grades: [],     labels: ['e', 'f'],      owner: 'Hal',  minQty: 9 },
  ],
  rowsLive: [
    { id: 1, title: 'Alpha',   grades: [1, 2], labels: ['a'],      owner: 'Dana', minQty: 1 },
    { id: 2, title: 'Beta',    grades: [3],    labels: ['x', 'b', 'y'], owner: 'Eli',  minQty: 3 },
    { id: 3, title: 'Gamma',   grades: [],     labels: ['c'],      owner: 'Fay',  minQty: 5 },
    { id: 4, title: 'Delta',   grades: [2, 4], labels: ['d', 'd2'],      owner: 'Dana', minQty: 8 },
    { id: 5, title: 'Epsilon', grades: [5],    labels: ['x'],      owner: 'Gus',  minQty: 2 },
    { id: 6, title: 'Zed',     grades: [],     labels: ['e', 'f'],      owner: 'Hal',  minQty: 9 },
  ],
  rowsTmode: [
    { id: 1, title: 'Alpha', owner: 'Dana' },
    { id: 2, title: 'Beta',  owner: 'Eli' },
    { id: 3, title: 'Gamma', owner: 'Fay' },
  ],
  sortTmode: [],
  rowsCfg: [
    { id: 1, title: 'Alpha',   grades: [1, 2], labels: ['a'],      owner: 'Dana' },
    { id: 2, title: 'Beta',    grades: [3],    labels: ['x', 'b', 'y'], owner: 'Eli' },
    { id: 3, title: 'Gamma',   grades: [],     labels: ['c'],      owner: 'Fay' },
    { id: 4, title: 'Delta',   grades: [2, 4], labels: ['d', 'd2'],      owner: 'Dana' },
    { id: 5, title: 'Epsilon', grades: [5],    labels: ['x'],      owner: 'Gus' },
    { id: 6, title: 'Zed',     grades: [],     labels: ['e', 'f'],      owner: 'Hal' },
  ],
  filtersCfg: [],
  sortCfg: [],
  rowsNoId: [
    { id: 1, title: 'Alpha' },
    { id: 2, title: 'Beta' },
    { id: 3, title: 'Gamma' },
  ],
  sortNoId: [{ id: 'title', desc: true }],
  rowsOneWay: [
    { id: 1, title: 'Alpha' },
    { id: 2, title: 'Beta' },
    { id: 3, title: 'Gamma' },
  ],
  filtersLive: [],
  sortLive: [],
  filters: [],
  sort: [],
  page: { pageIndex: 0, pageSize: 10 },
  selMode: 'none',
  threshold: 0,
  canUndoText: 'false',
  viewStateText: '',
  viewStateCount: 0,
  hold: true,
  selectedCount: 0,
}
</data>

<script lang="ts">
const rowId = (r: { id: number }): string => String(r.id)

// Custom list rule: '__empty' keeps rows whose list is empty; otherwise any overlap.
// Carries `autoRemove` and `resolveFilterValue` (table-core reads both OFF the filter fn):
// the filter value 'two' resolves to the list [2] before the rule runs.
const gradesRule = Object.assign(
  (v: any, f: any): boolean => (f === '__empty' ? !v?.length : !!v?.some((x: any) => f.includes(x))),
  {
    autoRemove: (f: any): boolean => f === 'none',
    resolveFilterValue: (f: any): any => (f === 'two' ? [2] : f),
  },
)

// Custom sort rule: by list length.
const labelsLenSort = (a: any, b: any): number => a.length - b.length

// Closure rule: reads live demo state, so it only sees a new threshold on a refresh.
const minQtyRule = (v: any): boolean => v >= $data.threshold

const onHistoryChange = (payload: { canUndo: boolean; canRedo: boolean } | null): void => {
  $data.canUndoText = String(payload ? payload.canUndo : false)
}

const setFilters = (next: any[]): void => {
  $data.filters = next
}
const filterLabelsX = (): void => setFilters([{ id: 'labels', value: ['x'] }])
const filterEmpty = (): void => setFilters([{ id: 'grades', value: '__empty' }])
const filterOwnerDana = (): void => setFilters([{ id: 'owner', value: 'Dana' }])
const filterThreshold = (): void => setFilters([{ id: 'minQty', value: 'on' }])
const filterResolve = (): void => setFilters([{ id: 'grades', value: 'two' }])
const sortLabelsLen = (): void => {
  $data.sort = [{ id: 'labels', desc: false }]
}
const clearFilters = (): void => setFilters([])
const bumpClosure = (): void => {
  $data.threshold = 5
}
const callUndo = (): void => {
  const api = $refs.dt
  if (api && api.undo) api.undo()
}
const callCanUndo = (): void => {
  const api = $refs.dt
  if (api && api.canUndo) $data.canUndoText = String(api.canUndo())
}
const refreshView = (): void => {
  const api = $refs.dt
  if (api && api.refreshView) api.refreshView()
}
const onViewStateChange = (payload: any): void => {
  $data.viewStateText = JSON.stringify(payload)
  $data.viewStateCount = $data.viewStateCount + 1
}
const onSelectionChange = (payload: any): void => {
  let n = 0
  for (const k of Object.keys(payload || {})) if (payload[k]) n++
  $data.selectedCount = n
}
// External swap: a brand-new, unstamped array of brand-new row objects — the seed values,
// except rows 2 and 3 are owned by 'Dana', so a released view under the owner=Dana filter
// shows [1, 2, 3, 4] while a view still (wrongly) held would keep [1, 4] with 2 mismatches
// (which also makes a stale intermediate emit observable: it differs from the pre-swap 1).
const swapData = (): void => {
  $data.rows = [
    { id: 1, title: 'Alpha',   grades: [1, 2], labels: ['a'],      owner: 'Dana', minQty: 1 },
    { id: 2, title: 'Beta',    grades: [3],    labels: ['x', 'b', 'y'], owner: 'Dana', minQty: 3 },
    { id: 3, title: 'Gamma',   grades: [],     labels: ['c'],      owner: 'Dana', minQty: 5 },
    { id: 4, title: 'Delta',   grades: [2, 4], labels: ['d', 'd2'],      owner: 'Dana', minQty: 8 },
    { id: 5, title: 'Epsilon', grades: [5],    labels: ['x'],      owner: 'Gus',  minQty: 2 },
    { id: 6, title: 'Zed',     grades: [],     labels: ['e', 'f'],      owner: 'Hal',  minQty: 9 },
  ]
}
const sortTitle = (): void => {
  $data.sort = [{ id: 'title', desc: false }]
}
const flipSort = (): void => {
  $data.sort = [{ id: 'title', desc: true }]
}
const selectionOn = (): void => {
  $data.selMode = 'multiple'
}
const selectAll = (): void => {
  const api = $refs.dt
  if (api && api.toggleAllRows) api.toggleAllRows(true)
}
// First click: pageSize 3, page 2 (rows 4-6 of the held order).
const nextPage = (): void => {
  $data.page = { pageIndex: $data.page.pageSize === 3 ? $data.page.pageIndex + 1 : 1, pageSize: 3 }
}
const holdOff = (): void => {
  $data.hold = false
}
const sortTitleLive = (): void => {
  $data.sortLive = [{ id: 'title', desc: false }]
}
const filterOwnerDanaLive = (): void => {
  $data.filtersLive = [{ id: 'owner', value: 'Dana' }]
}
const swapOneWay = (): void => {
  $data.rowsOneWay = [
    { id: 2, title: 'Beta' },
    { id: 3, title: 'Gamma' },
    { id: 4, title: 'Delta' },
  ]
}
const filterOwnerFayLive = (): void => {
  $data.filtersLive = [{ id: 'owner', value: 'Fay' }]
}
const filterTitleALive = (): void => {
  $data.filtersLive = [{ id: 'title', value: 'a' }]
}
// grid-tmode: open the owner editor (col 2) of visible row 0 through the editCell verb.
const editOwnerTmode = (): void => {
  const api = $refs.dtT
  if (api && api.editCell) api.editCell(0, 2)
}
const sortTitleDescTmode = (): void => {
  $data.sortTmode = [{ id: 'title', desc: true }]
}
// grid-cfg: a `:columns` config array — the buildConfigDef path for filterFn / sortingFn.
const cfgColumns = [
  { field: 'id', header: 'Id' },
  { field: 'title', header: 'Title', sortable: true },
  { field: 'grades', header: 'Grades', filterable: true, filterFn: gradesRule },
  { field: 'labels', header: 'Labels', filterable: true, sortable: true, filterFn: 'arrIncludesSome', sortingFn: labelsLenSort },
  { field: 'owner', header: 'Owner', filterable: true, filterFn: 'equalsString' },
]
const filterEmptyCfg = (): void => {
  $data.filtersCfg = [{ id: 'grades', value: '__empty' }]
}
const filterResolveCfg = (): void => {
  $data.filtersCfg = [{ id: 'grades', value: 'two' }]
}
const filterLabelsXCfg = (): void => {
  $data.filtersCfg = [{ id: 'labels', value: ['x'] }]
}
const sortLabelsLenCfg = (): void => {
  $data.sortCfg = [{ id: 'labels', desc: false }]
}
// grid-oneway-noid: ids are source indices. Old [Alpha, Beta, Gamma] (title desc → Gamma,
// Beta, Alpha); new [Beta, Gamma, Delta] (→ Gamma(1), Delta(2), Beta(0)). Following the
// index-id "1" would move the cursor to index 0 (a different record); the clamp keeps index 1.
const swapNoId = (): void => {
  $data.rowsNoId = [
    { id: 2, title: 'Beta' },
    { id: 3, title: 'Gamma' },
    { id: 4, title: 'Delta' },
  ]
}
const groupOwner = (): void => {
  const api = $refs.dt
  if (api && api.applyGrouping) api.applyGrouping(['owner'])
}
</script>

<template>
<div class="dt-held-view-demo">
  <h3>DataTable — per-column filterFn / held view</h3>

  <div class="controls">
    <button type="button" data-testid="filter-labels-x" @click="filterLabelsX">labels has x</button>
    <button type="button" data-testid="filter-empty" @click="filterEmpty">grades empty</button>
    <button type="button" data-testid="filter-owner-dana" @click="filterOwnerDana">owner Dana</button>
    <button type="button" data-testid="filter-threshold" @click="filterThreshold">minQty threshold</button>
    <button type="button" data-testid="filter-resolve" @click="filterResolve">grades two</button>
    <button type="button" data-testid="sort-labels-len" @click="sortLabelsLen">sort labels len</button>
    <button type="button" data-testid="clear-filters" @click="clearFilters">clear filters</button>
    <button type="button" data-testid="undo-btn" @click="callUndo">undo()</button>
    <button type="button" data-testid="bump-closure" @click="bumpClosure">threshold = 5</button>
    <button type="button" data-testid="refresh-view" @click="refreshView">refreshView()</button>
    <button type="button" data-testid="swap-data" @click="swapData">swap data</button>
    <button type="button" data-testid="sort-title" @click="sortTitle">sort title</button>
    <button type="button" data-testid="flip-sort" @click="flipSort">flip sort</button>
    <button type="button" data-testid="selection-on" @click="selectionOn">selection on</button>
    <button type="button" data-testid="select-all" @click="selectAll">select all</button>
    <button type="button" data-testid="next-page" @click="nextPage">next page (size 3)</button>
    <button type="button" data-testid="group-owner" @click="groupOwner">group owner</button>
    <button type="button" data-testid="canundo-btn" @click="callCanUndo">canUndo()</button>
    <button type="button" data-testid="hold-off" @click="holdOff">holdView off</button>
    <span class="label">canUndo:</span>
    <span class="readout" data-testid="canundo-readout">{{ $data.canUndoText }}</span>
    <span class="label">selected:</span>
    <span class="readout" data-testid="selected-count">{{ $data.selectedCount }}</span>
  </div>

  <span class="readout" data-testid="page-readout">{{ JSON.stringify($data.page) }}</span>
  <pre class="model" data-testid="view-state">{{ $data.viewStateText }}</pre>
  <span class="readout" data-testid="view-state-count">{{ $data.viewStateCount }}</span>

  <pre class="model" data-testid="model-readout">{{ JSON.stringify($data.rows) }}</pre>

  <div data-testid="grid-table">
    <DataTable
      ref="dt"
      interactionMode="grid"
      :undoable="true"
      :holdView="$data.hold"
      :selectionMode="$data.selMode"
      :getRowId="rowId"
      r-model:data="$data.rows"
      r-model:columnFilters="$data.filters"
      r-model:sorting="$data.sort"
      r-model:pagination="$data.page"
      @history-change="onHistoryChange($event)"
      @view-state-change="onViewStateChange($event)"
      @selection-change="onSelectionChange($event)"
    >
      <Column field="id" header="Id" />
      <Column field="title" header="Title" :editable="true" editor="text" :sortable="true" :filterable="true" />
      <Column field="grades" header="Grades" :filterable="true" :filterFn="gradesRule" />
      <Column field="labels" header="Labels" :filterable="true" :sortable="true" filterFn="arrIncludesSome" :sortingFn="labelsLenSort" />
      <Column field="owner" header="Owner" :editable="true" editor="text" :filterable="true" filterFn="equalsString" />
      <Column field="minQty" header="Min qty" :filterable="true" :filterFn="minQtyRule" />

      <template #cell="{ value }">
        <span data-testid="cell-display">{{ Array.isArray(value) ? value.join(',') : value }}</span>
      </template>
    </DataTable>
  </div>

  <h3>Live grid (holdView off) — the active cell follows its record</h3>
  <div class="controls">
    <button type="button" data-testid="sort-title-live" @click="sortTitleLive">sort title (live)</button>
    <button type="button" data-testid="filter-owner-dana-live" @click="filterOwnerDanaLive">owner Dana (live)</button>
    <button type="button" data-testid="filter-owner-fay-live" @click="filterOwnerFayLive">owner Fay (live)</button>
    <button type="button" data-testid="filter-title-a-live" @click="filterTitleALive">title has a (live)</button>
  </div>
  <pre class="model" data-testid="model-readout-live">{{ JSON.stringify($data.rowsLive) }}</pre>

  <div data-testid="grid-live">
    <DataTable
      interactionMode="grid"
      :getRowId="rowId"
      r-model:data="$data.rowsLive"
      r-model:columnFilters="$data.filtersLive"
      r-model:sorting="$data.sortLive"
    >
      <Column field="id" header="Id" />
      <Column field="title" header="Title" :editable="true" editor="text" :sortable="true" :filterable="true" />
      <Column field="grades" header="Grades" :filterable="true" :filterFn="gradesRule" />
      <Column field="labels" header="Labels" :filterable="true" :sortable="true" filterFn="arrIncludesSome" :sortingFn="labelsLenSort" />
      <Column field="owner" header="Owner" :editable="true" editor="text" :filterable="true" filterFn="equalsString" />
      <Column field="minQty" header="Min qty" :filterable="true" :filterFn="minQtyRule" />

      <template #cell="{ value }">
        <span data-testid="cell-display">{{ Array.isArray(value) ? value.join(',') : value }}</span>
      </template>
    </DataTable>
  </div>

  <h3>One-way data grid — an external swap clamps</h3>
  <div class="controls">
    <button type="button" data-testid="swap-oneway" @click="swapOneWay">swap data (one-way)</button>
  </div>
  <div data-testid="grid-oneway">
    <DataTable interactionMode="grid" :getRowId="rowId" :data="$data.rowsOneWay">
      <Column field="id" header="Id" />
      <Column field="title" header="Title" :editable="true" editor="text" />
    </DataTable>
  </div>

  <h3>Table-mode grid — an editor opened by editCell follows its record</h3>
  <div class="controls">
    <button type="button" data-testid="edit-owner-tmode" @click="editOwnerTmode">editCell(0, owner)</button>
    <button type="button" data-testid="sort-title-desc-tmode" @click="sortTitleDescTmode">sort title desc</button>
  </div>
  <pre class="model" data-testid="model-readout-tmode">{{ JSON.stringify($data.rowsTmode) }}</pre>
  <div data-testid="grid-tmode">
    <DataTable
      ref="dtT"
      :getRowId="rowId"
      r-model:data="$data.rowsTmode"
      r-model:sorting="$data.sortTmode"
    >
      <Column field="id" header="Id" />
      <Column field="title" header="Title" :editable="true" editor="text" :sortable="true" />
      <Column field="owner" header="Owner" :editable="true" editor="text" />
    </DataTable>
  </div>

  <h3>Columns-config grid — filterFn / sortingFn through the columns config</h3>
  <div class="controls">
    <button type="button" data-testid="filter-empty-cfg" @click="filterEmptyCfg">grades empty (cfg)</button>
    <button type="button" data-testid="filter-resolve-cfg" @click="filterResolveCfg">grades two (cfg)</button>
    <button type="button" data-testid="filter-labels-x-cfg" @click="filterLabelsXCfg">labels has x (cfg)</button>
    <button type="button" data-testid="sort-labels-len-cfg" @click="sortLabelsLenCfg">sort labels len (cfg)</button>
  </div>
  <div data-testid="grid-cfg">
    <DataTable
      interactionMode="grid"
      :getRowId="rowId"
      :columns="cfgColumns"
      :data="$data.rowsCfg"
      r-model:columnFilters="$data.filtersCfg"
      r-model:sorting="$data.sortCfg"
    />
  </div>

  <h3>One-way grid without getRowId — an external swap clamps</h3>
  <div class="controls">
    <button type="button" data-testid="swap-noid" @click="swapNoId">swap data (no getRowId)</button>
  </div>
  <div data-testid="grid-oneway-noid">
    <DataTable interactionMode="grid" :data="$data.rowsNoId" r-model:sorting="$data.sortNoId">
      <Column field="id" header="Id" />
      <Column field="title" header="Title" :sortable="true" />
    </DataTable>
  </div>
</div>
</template>

<style>
.dt-held-view-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 760px;
}
.dt-held-view-demo h3 { margin: 0 0 0.75rem; font-size: 1rem; }
.controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
  font-size: 0.8125rem;
}
.controls .label { color: #555; }
.controls .readout { font-weight: 600; font-family: ui-monospace, monospace; min-width: 1.5rem; }
.controls button {
  padding: 0.25rem 0.625rem;
  border: 1px solid rgba(0, 0, 0, 0.15);
  background: white;
  border-radius: 4px;
  cursor: pointer;
  font: inherit;
  font-size: 0.8125rem;
}
.model {
  font-size: 0.6875rem;
  font-family: ui-monospace, monospace;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 0 0 0.75rem;
  color: #333;
}
[data-testid="grid-table"] [role="gridcell"][tabindex="0"],
[data-testid="grid-table"] [role="columnheader"][tabindex="0"],
[data-testid="grid-live"] [role="gridcell"][tabindex="0"],
[data-testid="grid-live"] [role="columnheader"][tabindex="0"] {
  outline: 2px solid #2563eb;
  outline-offset: -2px;
}
.rdt-cell-editor { font: inherit; }
</style>

</rozie>
