<!--
  AutoIdDemo.rozie — BEHAVIORAL cell for the per-instance default id base (oinbox
  0.8.0 follow-up F6, quick 261002-ekf): two default-configured Selects must never
  share an id. Driven by tests/visual-regression/specs/auto-id.spec.ts on all 6
  targets. Behavioral-only — no pixel baseline.

  The two default-configured Popovers the same spec checks live in the sibling
  AutoIdPopoverDemo.rozie: Select composes the PUBLISHED @rozie-ui/popover-<target>
  leaf, so a page that also compiled Popover.rozie from source would register the
  `rozie-popover` custom element twice on Lit (a harness-only collision — a real
  page loads one copy of the leaf).
-->

<rozie name="AutoIdDemo">

<components>
{
  Select: '../../packages/ui/select/src/Select.rozie',
}
</components>

<data>
{
  a: null,
  b: null,
}
</data>

<script>
const OPTIONS = ['One', 'Two']
</script>

<template>
<div class="auto-id-demo">
  <Select r-model:value="$data.a" :options="OPTIONS" ariaLabel="List A" />
  <Select r-model:value="$data.b" :options="OPTIONS" ariaLabel="List B" />
</div>
</template>

<style>
.auto-id-demo {
  font-family: system-ui, -apple-system, sans-serif;
  padding: 1rem;
  display: flex;
  gap: 1rem;
  min-height: 200px;
}
</style>

</rozie>
