<!--
  DataTableBordersDemo.rozie — behavioral consumer for the border model
  (data-table-borders.spec.ts):

  - separate borders, so sticky header cells and pinned cells carry their own lines
    while the grid scrolls underneath them;
  - each cell resets its borders, so a host's plain `table td { border }` rule
    can't draw a second set of lines inside the table;
  - pinned body cells are opaque;
  - group-row and filter-row bands stay visible on pinned cells (layered over
    the opaque background);
  - the opt-in `columnLines` prop (toggled by the checkbox) draws a right border
    on every cell, plus the outer left and top edge lines.

  The first column is pinned left inside a fixed-size scroll box, with a sticky
  header and grid mode so a range can be selected in the pinned column.
-->

<rozie name="DataTableBordersDemo">

<components>
{
  DataTable: '../../packages/ui/data-table/src/DataTable.rozie',
  Column: '../../packages/ui/data-table/src/Column.rozie',
}
</components>

<data>
{
  rows: [],
  pagination: { pageIndex: 0, pageSize: 100 },
  columnLines: false,
  grouping: [],
  dir: 'ltr',
  rangeReadout: '',
}
</data>

<script lang="ts">
$onMount(() => {
  const out = []
  for (let i = 1; i <= 30; i++) {
    out.push({ id: i, name: 'Row ' + i, grp: i % 2 === 0 ? 'even' : 'odd', a: 'a' + i, b: 'b' + i, c: 'c' + i, d: 'd' + i, e: 'e' + i, f: 'f' + i })
  }
  $data.rows = out
})

const toggleColumnLines = (): void => {
  $data.columnLines = !$data.columnLines
}

const toggleDir = (): void => {
  $data.dir = $data.dir === 'rtl' ? 'ltr' : 'rtl'
}

const toggleGrouping = (): void => {
  $data.grouping = $data.grouping.length ? [] : ['grp']
}

const onRangeChange = (payload: { anchor: { rowIndex: number; colIndex: number } | null; focus: { rowIndex: number; colIndex: number } | null }): void => {
  const f = payload ? payload.focus : null
  $data.rangeReadout = f ? f.rowIndex + ',' + f.colIndex : ''
}
</script>

<template>
<div class="dt-borders-demo">
  <h3>DataTable — borders, pinned columns, column lines</h3>

  <div class="controls">
    <label>
      <input type="checkbox" data-testid="toggle-column-lines" :checked="$data.columnLines" @change="toggleColumnLines" />
      column lines
    </label>
    <button type="button" data-testid="toggle-dir" @click="toggleDir">toggle rtl</button>
    <button type="button" data-testid="toggle-grouping" @click="toggleGrouping">group by grp</button>
    <span class="readout" data-testid="range-readout">{{ $data.rangeReadout }}</span>
  </div>

  <div class="scroll-box" data-testid="scroll-box" :dir="$data.dir">
    <DataTable
      interactionMode="grid"
      :data="$data.rows"
      :stickyHeader="true"
      :columnLines="$data.columnLines"
      r-model:pagination="$data.pagination"
      r-model:grouping="$data.grouping"
      @range-change="onRangeChange($event)"
    >
      <Column field="name" header="Name" pinned="left" :filterable="true" />
      <Column field="grp" header="Group" />
      <Column field="a" header="A" :filterable="true" />
      <Column field="b" header="B" />
      <Column field="c" header="C" />
      <Column field="d" header="D" />
      <Column field="e" header="E" />
      <Column field="f" header="F" />
    </DataTable>
  </div>
</div>
</template>

<style>
.dt-borders-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 420px;
}
.dt-borders-demo h3 { margin: 0 0 0.75rem; font-size: 1rem; }
.controls { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.5rem; font-size: 0.8125rem; }
.scroll-box {
  height: 200px;
  width: 400px;
  overflow: auto;
  border: 1px solid rgba(0, 0, 0, 0.12);
}
</style>

</rozie>
