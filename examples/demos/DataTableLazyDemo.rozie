<!--
  DataTableLazyDemo.rozie — virtual lazy loading (quick 260925-dtl part 2, oinbox dogfooding:
  a 50k-row server-paged list with no way to learn which rows are on screen).

  `virtual` + `manual` + `rowCount` 10,000 over SPARSE data: only rows 0–49 are loaded at
  mount; every other index is a hole the table renders as a placeholder row. The table reports
  its rendered window through `visible-range-change`; "Load visible range" fills exactly that
  window, the way a consumer's fetch would (kept manual here so the placeholders are
  observable before they fill).
-->
<rozie name="DataTableLazyDemo">

<components>
{
  DataTable: '../../packages/ui/data-table/src/DataTable.rozie',
  Column: '../../packages/ui/data-table/src/Column.rozie',
}
</components>

<data>
{
  rows: Array.from({ length: 50 }, (_, i) => ({ id: 'r' + i, name: 'Row ' + i })),
  range: '',
  lastStart: 0,
  lastEnd: 0,
  sel: {},
}
</data>

<script>
const makeRow = (i) => ({ id: 'r' + i, name: 'Row ' + i })
const rowIdOf = (row) => row.id
const onRange = (r) => {
  $data.range = r.start + '-' + r.end
  $data.lastStart = r.start
  $data.lastEnd = r.end
}
const loadRange = () => {
  const next = $data.rows.slice()
  for (let i = $data.lastStart; i < $data.lastEnd; i++) next[i] = makeRow(i)
  $data.rows = next
}
const loadedCount = () => $data.rows.filter((x) => x != null).length
const selectedCount = () => Object.keys($data.sel).filter((k) => $data.sel[k]).length
</script>

<template>
<div class="dt-demo">
  <button type="button" data-testid="load-range" @click="loadRange()">Load visible range</button>
  <span class="readout" data-testid="range">{{ $data.range }}</span>
  <span class="readout" data-testid="selected-count">{{ selectedCount() }}</span>
  <span class="readout" data-testid="loaded-count">{{ loadedCount() }}</span>
  <section data-testid="lazy-table">
    <DataTable
      :data="$data.rows"
      virtual
      manual
      :rowCount="10000"
      maxHeight="320px"
      :estimateRowHeight="40"
      selectionMode="multiple"
      :getRowId="rowIdOf"
      r-model:rowSelection="$data.sel"
      @visible-range-change="onRange"
    >
      <Column field="name" header="Name" />
    </DataTable>
  </section>
</div>
</template>

<style>
.dt-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 460px;
}
</style>

</rozie>
