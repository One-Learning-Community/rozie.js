<!--
  DataTableFilterDropinsDemo.rozie — runtime behavioral cell for the @rozie-ui/data-table
  #filter slot DROP-INS (FilterText / FilterSelect / FilterNumberRange).

  Mirrors DataTableFacetDemo.rozie's structure (static dataset in <data>, the
  r-model:columnFilters controlled write-back, the #filter scoped slot dispatched by
  columnId) but SWAPS the hand-rolled checkbox/range facet content for the real drop-in
  components imported cross-tree from packages/ui/data-table/src. The drop-ins receive the
  declared #filter slot scope ({ columnId, uniqueValues, minMax, setFilter } — the producer
  declares no column/value; those are optional drop-in props defaulting to null) as props
  and call setFilter(columnId, value) to drive the columnFilters model.

  Loop-var / slot discipline (DataTable.rozie Svelte mount-throw): NO loop var or slot named
  `cell`; the #cell display slot binds `value`. Static dataset (no clock/random) for
  determinism. NO <data> field collides with a slot let-var (row/value/columnId/grouping).
-->

<rozie name="DataTableFilterDropinsDemo">

<components>
{
  DataTable: '../../packages/ui/data-table/src/DataTable.rozie',
  Column: '../../packages/ui/data-table/src/Column.rozie',
  FilterText: '../../packages/ui/data-table/src/FilterText.rozie',
  FilterSelect: '../../packages/ui/data-table/src/FilterSelect.rozie',
  FilterNumberRange: '../../packages/ui/data-table/src/FilterNumberRange.rozie',
}
</components>

<data>
{
  // A static dataset with a text column (name), a categorical column (category: distinct
  // Hardware/Software/Service), and a numeric column (price, 10..90). VR-deterministic.
  // Hardware rows = Alpha + Gamma (2 of 5); price range 10..90.
  rows: [
    { id: 1, name: 'Alpha',   category: 'Hardware', price: 30 },
    { id: 2, name: 'Beta',    category: 'Software', price: 90 },
    { id: 3, name: 'Gamma',   category: 'Hardware', price: 10 },
    { id: 4, name: 'Delta',   category: 'Service',  price: 50 },
    { id: 5, name: 'Epsilon', category: 'Software', price: 70 },
  ],
  // The controlled columnFilters model (Phase 48) the drop-ins drive via setFilter — an
  // array of { id, value }. model:true two-way.
  columnFilters: [],
}
</data>

<script lang="ts">
// C-08: write the columnFilters model DIRECTLY — never through the drop-ins' own setFilter —
// so the re-sync being tested is genuinely an outside-in one.
const setNameFilter = (): void => {
  $data.columnFilters = [{ id: 'name', value: 'Gam' }]
}
const setPriceFilter = (): void => {
  $data.columnFilters = [{ id: 'price', value: [20, 60] }]
}
const clearFilters = (): void => {
  $data.columnFilters = []
}
</script>

<template>
<div class="dt-filter-demo">
  <h3>DataTable — #filter slot drop-ins</h3>

  <!-- C-08 vehicle: change the column filters from OUTSIDE the drop-in inputs, the way a
       "Clear filters" button or any other control in a real app does. The drop-ins hold a
       local draft seeded once at setup, so without a re-sync watch they keep displaying the
       old text while the table filters by something else. -->
  <div class="controls">
    <button type="button" data-testid="set-name-filter" @click="setNameFilter">set name filter = Gam</button>
    <button type="button" data-testid="set-price-filter" @click="setPriceFilter">set price filter = 20..60</button>
    <button type="button" data-testid="clear-filters" @click="clearFilters">clear all filters</button>
    <span class="label">filters:</span>
    <span class="readout" data-testid="filters-readout">{{ JSON.stringify($data.columnFilters) }}</span>
  </div>

  <div data-testid="filter-table">
    <DataTable
      :data="$data.rows"
      r-model:columnFilters="$data.columnFilters"
    >
      <Column field="name"     header="Name"     :filterable="true" />
      <Column field="category" header="Category" :filterable="true" />
      <Column field="price"    header="Price"    :filterable="true" />

      <!-- The default #cell display slot (read-only display path). -->
      <template #cell="{ value }">
        <span data-testid="cell-display">{{ value }}</span>
      </template>

      <!-- The #filter scoped slot, dispatched by columnId to the real drop-ins. The producer
           declares { columnId, value, uniqueValues, minMax, setFilter, columnLabel }; the
           drop-ins call setFilter(columnId, value) to apply.

           C-08 (260921-tsu): `:value` is forwarded to EVERY drop-in, not just FilterSelect.
           It used to go only to FilterSelect — a stale comment here still claimed the producer
           did not declare `value` at all — so FilterText and FilterNumberRange received null
           forever. They could not seed from an existing filter and could not re-sync when one
           changed from outside, and no fixture could have caught either, because nothing was
           ever passed for them to sync FROM. -->
      <template #filter="{ columnId, value, uniqueValues, minMax, setFilter, columnLabel }">
        <FilterText
          r-if="columnId === 'name'"
          :columnId="columnId"
          :columnLabel="columnLabel"
          :value="value"
          :setFilter="setFilter"
        />
        <FilterSelect
          r-else-if="columnId === 'category'"
          :columnId="columnId"
          :columnLabel="columnLabel"
          :value="value"
          :setFilter="setFilter"
          :uniqueValues="uniqueValues"
        />
        <FilterNumberRange
          r-else-if="columnId === 'price'"
          :columnId="columnId"
          :columnLabel="columnLabel"
          :value="value"
          :setFilter="setFilter"
          :minMax="minMax"
        />
      </template>
    </DataTable>
  </div>
</div>
</template>

<style>
.dt-filter-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  width: 560px;
}
.dt-filter-demo h3 { margin: 0 0 0.75rem; font-size: 1rem; }
</style>

</rozie>
