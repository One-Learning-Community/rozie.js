<!--
  FlowCanvasLargeDemo.rozie — the SCALE cell for the FlowCanvas (Rete.js) wrapper
  (quick-260803-uwb). Every other rete-flow demo seeds 1–5 nodes; this one seeds the size
  of graph a real workflow-builder consumer actually hits.

  48 NODES / 86 CONNECTIONS of ETL-shaped dataflow: eight layers (4-7-8-8-7-6-5-3) of
  source → transform/join → sink, with genuine FAN-IN (1–3 in-edges per node), FAN-OUT (a
  layer node feeds several successors) and long chains — plus mixed edge types
  (bezier/step/smoothstep/straight), labels, custom strokes and dashed edges, so the render
  pipe, the socket-position watcher and the path renderer are all exercised at volume.

  DETERMINISM: the builder is a PURE FUNCTION OF THE LOOP INDICES — no `Math.random`, no
  `Date.now`, no module counter. That is strictly stronger than a seeded PRNG (there is no
  state to get out of sync between targets), which the VR cell needs because it pins exact
  literals: `node-count` '48' and `conn-count` '86'.

    LAYERS  = [4, 7, 8, 8, 7, 6, 5, 3]            // 48 nodes
    id      = 'L' + L + 'N' + j                    // unique, no substring collisions
    label   = the id                               // so hasText:'L3N4' resolves exactly 1
    type    = L===0 ? 'source' : L===7 ? 'sink' : (L%2===1 ? 'transform' : 'join')
    seed    = { x: 40 + L*30, y: 40 + j*14 }       // DELIBERATELY overlapping (node ≈140×40)
    fanIn   = 1 + ((j + L) % 3)                    // 1..3 in-edges
    src     = 'L' + (L-1) + 'N' + ((j + k) % LAYERS[L-1])

  `(j + k) % prevLen` cannot collide within a node because every previous layer has ≥ 4
  members while fanIn ≤ 3 — so no dedup is needed and the edge count is exactly 86
  (14+16+15+14+12+9+6).

  ⚠ EVERY `<Port input>` HERE CARRIES `multiple`. `<Port input>` defaults to a SINGLE
  connection (Port.rozie:79-87); with a single input, a second incoming edge EVICTS the
  first (a shipped, separately-asserted behaviour), so a fan-in graph would silently settle
  well under 86 edges. If `conn-count` ever reads low here, check the `multiple` attributes
  before suspecting the component.

  The seed positions deliberately OVERLAP — layers are 30px apart on ~140px-wide nodes —
  so the cell can prove `autoArrange()` untangles a genuinely tangled graph (the "START
  OVERLAPPING" discipline the shipped 2-node arrange cell established, at 24× the size).

  BEHAVIORAL-ONLY. There is deliberately NO pixel cell for the arranged graph: autoArrange
  feeds elk the MEASURED `offsetWidth`/`offsetHeight` of each node view
  (FlowCanvas.rozie:3415-3445), so the layout is a function of per-platform font metrics,
  and elk runs through a web-worker (scheduling non-determinism on top). The shipped
  2-node arrange cell already refuses exact-px assertions for exactly this reason
  ("a RELATIVE non-overlap assertion (not exact px, which is layout-engine-dependent)",
  rete-flow.spec.ts:1606). Determinism is not provable, so the cell asserts behaviour.

  Seeded in `$onMount` rather than `<data>` (the 1,000-option ListboxVirtual precedent) and
  assigned as ONE fresh graph object — one commit, not 48.

  Container needs explicit height/width (the VR host mounts at max-content).
-->

<rozie name="FlowCanvasLargeDemo">

<components>
{
  FlowCanvas: '../../packages/ui/rete/src/FlowCanvas.rozie',
  NodeType:   '../../packages/ui/rete/src/NodeType.rozie',
  Port:       '../../packages/ui/rete/src/Port.rozie',
}
</components>

<data>
{
  // THE SINGLE SOURCE OF TRUTH — filled once in $onMount by the pure index builder.
  graph: { nodes: [], connections: [] },
  // two-way viewport zoom — the zoomToFit() proof (the verb echoes $model.zoom).
  zoom: 1,
  // settled selected-node count (from @selection-change) — the select-all-at-scale proof.
  selectedCount: 0,
}
</data>

<script>
// Layer sizes: 4+7+8+8+7+6+5+3 = 48 nodes.
const LAYERS = [4, 7, 8, 8, 7, 6, 5, 3]

// Build the whole ETL pipeline as a PURE function of the loop indices (see the header):
// every id, type, position, edge and edge decoration is derived arithmetically, so all six
// targets seed a byte-identical graph with no PRNG state to diverge.
$onMount(() => {
  const nodes = []
  for (let L = 0; L < LAYERS.length; L++) {
    for (let j = 0; j < LAYERS[L]; j++) {
      const id = 'L' + L + 'N' + j
      const type = L === 0 ? 'source' : L === 7 ? 'sink' : (L % 2 === 1 ? 'transform' : 'join')
      // DELIBERATELY overlapping seeding — 30px of x per layer on ~140px-wide nodes.
      nodes.push({ id, type, x: 40 + L * 30, y: 40 + j * 14, data: { label: id } })
    }
  }

  const connections = []
  for (let L = 1; L < LAYERS.length; L++) {
    for (let j = 0; j < LAYERS[L]; j++) {
      // 1..3 in-edges. `(j + k) % LAYERS[L-1]` is collision-free within a node because
      // every previous layer has ≥ 4 members and fanIn ≤ 3.
      const fanIn = 1 + ((j + L) % 3)
      for (let k = 0; k < fanIn; k++) {
        const i = connections.length
        const source = 'L' + (L - 1) + 'N' + ((j + k) % LAYERS[L - 1])
        const conn = {
          id: 'e' + i,
          source,
          sourceOutput: 'out',
          target: 'L' + L + 'N' + j,
          targetInput: 'in',
        }
        // mixed edge decoration, all keyed off the running edge index (i % 4 === 0 leaves
        // `type` unset = the default bezier).
        if (i % 4 === 1) conn.type = 'step'
        if (i % 4 === 2) conn.type = 'smoothstep'
        if (i % 4 === 3) conn.type = 'straight'
        if (i % 3 === 0) conn.label = 'f' + i
        if (i % 5 === 0) conn.stroke = '#16a34a'
        if (i % 7 === 0) conn.dashed = true
        connections.push(conn)
      }
    }
  }

  // ONE assignment — a fresh graph object committed once, not 48 incremental writes.
  $data.graph = { nodes, connections }
})

// @selection-change surfaces the selected node id set ({ ids }) — the settled count is the
// select-all-at-scale readout.
const onSelectionChange = (e) => {
  $data.selectedCount = e && Array.isArray(e.ids) ? e.ids.length : 0
}

// The imperative verbs, read off the $refs handle inside the click handlers (post-mount,
// ROZ123-safe). autoArrange() is async (elkjs through a web-worker); we do NOT await — the
// bound graph re-binds when it resolves and the readouts follow (the spec polls the settled
// values, the shipped arrange-cell contract).
const doArrange = () => { const c = $refs.canvas; if (c && c.autoArrange) c.autoArrange() }
const doFit = () => { const c = $refs.canvas; if (c && c.zoomToFit) c.zoomToFit() }
const doUndo = () => { const c = $refs.canvas; if (c && c.undo) c.undo() }

// Readout helpers, called from {{ }} (the established function-call-in-template idiom).
// All read the BOUND model, so a dead write-back fails here.
const bboxW = () => {
  const ns = $data.graph.nodes
  if (!ns || ns.length === 0) return 0
  let mn = Infinity
  let mx = -Infinity
  for (const n of ns) {
    if (n.x < mn) mn = n.x
    if (n.x > mx) mx = n.x
  }
  return Math.round(mx - mn)
}
const bboxH = () => {
  const ns = $data.graph.nodes
  if (!ns || ns.length === 0) return 0
  let mn = Infinity
  let mx = -Infinity
  for (const n of ns) {
    if (n.y < mn) mn = n.y
    if (n.y > mx) mx = n.y
  }
  return Math.round(mx - mn)
}
// the x of ONE named node (the drag/undo target), off the bound graph.
const dragNodeX = () => {
  const ns = $data.graph.nodes
  const hit = ns ? ns.filter((n) => String(n.id) === 'L3N4') : []
  return hit.length > 0 ? Math.round(hit[0].x) : -1
}
// a fixed 2dp STRING — a raw float renders with target-dependent precision.
const zoomText = () => Number($data.zoom).toFixed(2)
</script>

<template>
<div class="flow-demo">
  <h3>FlowCanvas — 48-node / 86-edge pipeline (behavioral scale)</h3>

  <div class="controls">
    <button type="button" data-testid="arrange-btn" @click="doArrange">autoArrange</button>
    <button type="button" data-testid="fit-btn" @click="doFit">zoomToFit</button>
    <button type="button" data-testid="undo-btn" @click="doUndo">undo</button>
  </div>

  <div class="controls">
    <!-- all read off the BOUND graph model. -->
    <span class="readout" data-testid="node-count">{{ $data.graph.nodes.length }}</span>
    <span class="readout" data-testid="conn-count">{{ $data.graph.connections.length }}</span>
    <span class="readout" data-testid="selected-count">{{ $data.selectedCount }}</span>
    <span class="readout" data-testid="zoom-readout">{{ zoomText() }}</span>
    <span class="readout" data-testid="bbox-w">{{ bboxW() }}</span>
    <span class="readout" data-testid="bbox-h">{{ bboxH() }}</span>
    <span class="readout" data-testid="drag-node-x">{{ dragNodeX() }}</span>
  </div>

  <div class="flow-wrap" style="height: 460px; width: 900px">
    <FlowCanvas
      ref="canvas"
      r-model:graph="$data.graph"
      r-model:zoom="$data.zoom"
      :fit-on-mount="false"
      :minimap="true"
      @selection-change="onSelectionChange"
    >
      <!-- Four types, one minimal #body each (the node's id as its label). EVERY input is
           `multiple` — a single input would EVICT earlier fan-in edges (see the header). -->
      <NodeType type="source">
        <template #body="{ node }">
          <div class="rozie-demo-node"><strong>{{ node.data.label }}</strong></div>
        </template>
        <Port input="in" label="in" multiple />
        <Port output="out" label="out" />
      </NodeType>

      <NodeType type="transform">
        <template #body="{ node }">
          <div class="rozie-demo-node"><strong>{{ node.data.label }}</strong></div>
        </template>
        <Port input="in" label="in" multiple />
        <Port output="out" label="out" />
      </NodeType>

      <NodeType type="join">
        <template #body="{ node }">
          <div class="rozie-demo-node"><strong>{{ node.data.label }}</strong></div>
        </template>
        <Port input="in" label="in" multiple />
        <Port output="out" label="out" />
      </NodeType>

      <NodeType type="sink">
        <template #body="{ node }">
          <div class="rozie-demo-node"><strong>{{ node.data.label }}</strong></div>
        </template>
        <Port input="in" label="in" multiple />
        <Port output="out" label="out" />
      </NodeType>
    </FlowCanvas>
  </div>
</div>
</template>

<style>
.flow-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  max-width: 940px;
}
.flow-demo h3 { margin: 0 0 0.75rem; font-size: 1rem; }
.controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
  flex-wrap: wrap;
}
.controls .readout {
  font-variant-numeric: tabular-nums;
  font-size: 0.875rem;
  min-width: 2ch;
}

:root {
  /* the #body chrome teleports into the engine node element inside the canvas shadow
     root, so on Lit a plain scoped rule cannot reach it — :root emits document-level
     CSS adopted into the shadow root. NOT :global() (ROZ128 hard error). */
  .rozie-flow-canvas .rozie-demo-node {
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: #111827;
    white-space: nowrap;
  }
}
</style>

</rozie>
