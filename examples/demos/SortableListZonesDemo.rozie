<!--
  SortableListZonesDemo.rozie — behavioral-only fixture for keyboard moves
  BETWEEN SortableLists (Shift+Arrow hops a lifted row into the previous /
  next list of the same group).

  The CMS shape: three zones in handle mode sharing `group: 'zones'` —
  Top sidebar, Content, Bottom sidebar — plus, in source order:
    - `Locked` (`pull: false`: nothing hops out of it) first,
    - a clone palette (`Palette`: `pull: 'clone'`, `put: false`, the
      recommended palette shape — it takes nothing back) before Top sidebar,
    - a "Grid" widget in Content whose row renders two nested lists
      (`Grid column 1`, `Grid column 2`) in the same group,
    - a `put: false` list (`Archive`) after Bottom sidebar,
    - a list inside a `hidden` div after Archive,
    - two HORIZONTAL lists in another group (`tools`): Toolbar A, Toolbar B.
  Every `zones` list renders the same row template, so a Grid row keeps its
  columns wherever it lands.

  Controls:
    - `add-to-content`           appends a new widget to Content,
    - `move-top-first-to-bottom` moves Top sidebar's first widget to the end
                                 of Bottom sidebar (a consumer-side change
                                 that takes a lifted row away from its list),
    - `toggle-top` / `toggle-palette` unmount / remount those lists,
    - `hide-top`                 hides Top sidebar (display: none) without
                                 unmounting it,
    - `replace-newsletter`       swaps the Newsletter item (in Top sidebar or
                                 Content) for a new object with the SAME id,
    - `rekey-newsletter`         swaps it for a new object with a NEW id (what
                                 a consumer minting ids in `add` would do),
    - `mode-row`                 switches every list to keyboardTrigger 'row'.

  Every list has its own state sidecar `<ol class="state-list state-{slug}">`
  and every emitted event lands in `<ol class="event-log">` as
  `{slug}:{event}:{interaction}`. The last keyboard `end` payload is shown in
  `<output data-testid="last-end">` as JSON ({ item, el, interaction }, with
  `item` reported as the item's label and `el` as "element" or null).
  `<output data-testid="end-state">` shows the Palette, Top sidebar and Content
  labels as the last `end` handler read them (JSON).

  NOT a screenshot cell (deliberately absent from matrix.spec.ts EXAMPLES).
-->

<rozie name="SortableListZonesDemo">

<components>
{
  SortableList: '../../packages/ui/sortable-list/src/SortableList.rozie',
}
</components>

<data>
{
  locked: [],
  palette: [],
  top: [],
  content: [],
  grid1: [],
  grid2: [],
  bottom: [],
  archive: [],
  stash: [],
  toola: [],
  toolb: [],
  log: [],
  lastEnd: '',
  endState: '',
  trigger: 'handle',
  topMounted: true,
  topHidden: false,
  paletteMounted: true,
  added: 0,
}
</data>

<script>
const seed = () => {
  $data.locked = [{ id: 'l1', label: 'Pinned notice' }]
  $data.palette = [
    { id: 'p1', label: 'Text block' },
    { id: 'p2', label: 'Image' },
  ]
  $data.top = [
    { id: 't1', label: 'Search' },
    { id: 't2', label: 'Newsletter' },
    { id: 't3', label: 'Tag cloud' },
  ]
  $data.content = [
    { id: 'c1', label: 'Hero banner' },
    { id: 'c2', label: 'Intro text' },
    { id: 'grid', label: 'Grid', grid: true },
    { id: 'c3', label: 'Gallery' },
  ]
  $data.grid1 = [{ id: 'g1', label: 'Left card' }]
  $data.grid2 = [{ id: 'g2', label: 'Right card' }]
  $data.bottom = [
    { id: 'b1', label: 'Recent posts' },
    { id: 'b2', label: 'Contact' },
  ]
  $data.archive = [{ id: 'a1', label: 'Old promo' }]
  $data.stash = [{ id: 'x1', label: 'Hidden widget' }]
  $data.toola = [
    { id: 'ta1', label: 'Bold' },
    { id: 'ta2', label: 'Italic' },
    { id: 'ta3', label: 'Underline' },
  ]
  $data.toolb = [
    { id: 'tb1', label: 'Link' },
    { id: 'tb2', label: 'Quote' },
  ]
}

// Lit delivers a child $emit as a CustomEvent with the payload in `detail`;
// the other targets hand over the payload itself.
const payloadOf = (e) => {
  if (e != null && e.interaction == null && e.detail != null && e.detail.interaction != null) return e.detail
  return e
}

const interactionOf = (e) => {
  const p = payloadOf(e)
  return p != null && p.interaction != null ? p.interaction : '?'
}

const record = (slug, name, e) => {
  $data.log = [...$data.log, slug + ':' + name + ':' + interactionOf(e)]
  const p = payloadOf(e)
  if (name === 'end') {
    // What a consumer `end` handler sees in its bound arrays.
    const labels = (list) => list.map((it) => it.label)
    $data.endState = JSON.stringify({ palette: labels($data.palette), top: labels($data.top), content: labels($data.content) })
  }
  if (name === 'end' && p != null && p.interaction === 'keyboard') {
    $data.lastEnd = JSON.stringify({
      item: p.item != null && p.item.label != null ? p.item.label : null,
      el: p.el == null ? null : 'element',
      interaction: p.interaction,
    })
  }
}

const addToContent = () => {
  const n = $data.added + 1
  $data.added = n
  $data.content = [...$data.content, { id: 'n' + n, label: 'New widget ' + n }]
}

const moveTopFirstToBottom = () => {
  if ($data.top.length === 0) return
  const first = $data.top[0]
  $data.top = $data.top.slice(1)
  $data.bottom = [...$data.bottom, first]
}

const emptyTop = () => {
  $data.bottom = [...$data.bottom, ...$data.top]
  $data.top = []
}

const toggleTop = () => {
  $data.topMounted = !$data.topMounted
}

const toggleTopHidden = () => {
  $data.topHidden = !$data.topHidden
}

// Replace the Newsletter item wherever it sits (Top sidebar or Content) with a
// new object: same id (`rekey` false) or a fresh id (`rekey` true).
const swapNewsletter = (rekey) => {
  const fix = (list) => list.map((it) => (it.label === 'Newsletter' ? { ...it, id: rekey ? it.id + '-r' : it.id } : it))
  $data.top = fix($data.top)
  $data.content = fix($data.content)
}

const togglePalette = () => {
  $data.paletteMounted = !$data.paletteMounted
}

const setRowMode = () => {
  $data.trigger = 'row'
}

$onMount(() => seed())
</script>

<template>
<div class="zones-demo">
  <div class="controls">
    <button type="button" data-testid="add-to-content" @click="addToContent">Add to content</button>
    <button type="button" data-testid="move-top-first-to-bottom" @click="moveTopFirstToBottom">Move top first to bottom</button>
    <button type="button" data-testid="empty-top" @click="emptyTop">Move all of top to bottom</button>
    <button type="button" data-testid="toggle-top" @click="toggleTop">Toggle top sidebar</button>
    <button type="button" data-testid="toggle-palette" @click="togglePalette">Toggle palette</button>
    <button type="button" data-testid="hide-top" @click="toggleTopHidden">Hide top sidebar</button>
    <button type="button" data-testid="replace-newsletter" @click="swapNewsletter(false)">Replace Newsletter</button>
    <button type="button" data-testid="rekey-newsletter" @click="swapNewsletter(true)">Re-key Newsletter</button>
    <button type="button" data-testid="mode-row" @click="setRowMode">Row mode</button>
  </div>

  <section data-testid="zone-locked">
    <h4>Locked (pull: false)</h4>
    <SortableList
      r-model:items="$data.locked"
      itemKey="id"
      group="zones"
      :options="{ group: { name: 'zones', pull: false } }"
      listLabel="Locked"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('locked', 'start', $event)"
      @reorder="record('locked', 'reorder', $event)"
      @end="record('locked', 'end', $event)"
      @add="record('locked', 'add', $event)"
      @remove="record('locked', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
    <ol class="state-list state-locked">
      <li r-for="item, index in $data.locked" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <section data-testid="zone-palette">
    <h4>Palette</h4>
    <SortableList
      r-if="$data.paletteMounted"
      r-model:items="$data.palette"
      itemKey="id"
      group="zones"
      :options="{ group: { name: 'zones', pull: 'clone', put: false } }"
      listLabel="Palette"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('palette', 'start', $event)"
      @reorder="record('palette', 'reorder', $event)"
      @end="record('palette', 'end', $event)"
      @add="record('palette', 'add', $event)"
      @remove="record('palette', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
    <ol class="state-list state-palette">
      <li r-for="item, index in $data.palette" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <section data-testid="zone-top">
    <h4>Top sidebar</h4>
    <div :style="$data.topHidden ? 'display: none' : ''">
    <SortableList
      r-if="$data.topMounted"
      r-model:items="$data.top"
      itemKey="id"
      group="zones"
      keyboardInstructions="Press Space to pick up this widget. Shift with an arrow key moves it to another zone."
      listLabel="Top sidebar"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('top', 'start', $event)"
      @reorder="record('top', 'reorder', $event)"
      @end="record('top', 'end', $event)"
      @add="record('top', 'add', $event)"
      @remove="record('top', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
    </div>
    <ol class="state-list state-top">
      <li r-for="item, index in $data.top" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <section data-testid="zone-content">
    <h4>Content</h4>
    <SortableList
      r-model:items="$data.content"
      itemKey="id"
      group="zones"
      listLabel="Content"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('content', 'start', $event)"
      @reorder="record('content', 'reorder', $event)"
      @end="record('content', 'end', $event)"
      @add="record('content', 'add', $event)"
      @remove="record('content', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
    <ol class="state-list state-content">
      <li r-for="item, index in $data.content" :key="item.id">{{ item.label }}</li>
    </ol>
    <ol class="state-list state-grid1">
      <li r-for="item, index in $data.grid1" :key="item.id">{{ item.label }}</li>
    </ol>
    <ol class="state-list state-grid2">
      <li r-for="item, index in $data.grid2" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <section data-testid="zone-bottom">
    <h4>Bottom sidebar</h4>
    <SortableList
      r-model:items="$data.bottom"
      itemKey="id"
      group="zones"
      listLabel="Bottom sidebar"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('bottom', 'start', $event)"
      @reorder="record('bottom', 'reorder', $event)"
      @end="record('bottom', 'end', $event)"
      @add="record('bottom', 'add', $event)"
      @remove="record('bottom', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
    <ol class="state-list state-bottom">
      <li r-for="item, index in $data.bottom" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <section data-testid="zone-archive">
    <h4>Archive (put: false)</h4>
    <SortableList
      r-model:items="$data.archive"
      itemKey="id"
      group="zones"
      :options="{ group: { name: 'zones', put: false } }"
      listLabel="Archive"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('archive', 'start', $event)"
      @reorder="record('archive', 'reorder', $event)"
      @end="record('archive', 'end', $event)"
      @add="record('archive', 'add', $event)"
      @remove="record('archive', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
    <ol class="state-list state-archive">
      <li r-for="item, index in $data.archive" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <div hidden>
  <section data-testid="zone-hidden">
    <h4>Hidden zone</h4>
    <SortableList
      r-model:items="$data.stash"
      itemKey="id"
      group="zones"
      listLabel="Hidden zone"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
          <input class="row-input" placeholder="title" />
        </span>
        <div r-if="item.grid" class="grid-cols">
          <SortableList
            r-model:items="$data.grid1"
            itemKey="id"
            group="zones"
            listLabel="Grid column 1"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid1', 'start', $event)"
            @reorder="record('grid1', 'reorder', $event)"
            @end="record('grid1', 'end', $event)"
            @add="record('grid1', 'add', $event)"
            @remove="record('grid1', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
          <SortableList
            r-model:items="$data.grid2"
            itemKey="id"
            group="zones"
            listLabel="Grid column 2"
            :keyboardTrigger="$data.trigger"
            :handle="$classSelector('grip')"
            @start="record('grid2', 'start', $event)"
            @reorder="record('grid2', 'reorder', $event)"
            @end="record('grid2', 'end', $event)"
            @add="record('grid2', 'add', $event)"
            @remove="record('grid2', 'remove', $event)"
          >
            <template #default="{ item: cell, instructionsId: cellDesc }">
              <span class="row">
                <button type="button" class="grip" :aria-label="'Reorder ' + cell.label" :aria-describedby="cellDesc">⋮⋮</button>
                <span class="label">{{ cell.label }}</span>
              </span>
            </template>
          </SortableList>
        </div>
      </template>
    </SortableList>
  </section>
  </div>
    <ol class="state-list state-hidden">
      <li r-for="item, index in $data.stash" :key="item.id">{{ item.label }}</li>
    </ol>
  <section data-testid="zone-toola">
    <h4>Toolbar A</h4>
    <SortableList
      r-model:items="$data.toola"
      itemKey="id"
      group="tools"
      orientation="horizontal"
      listClass="toolbar"
      listLabel="Toolbar A"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('toola', 'start', $event)"
      @reorder="record('toola', 'reorder', $event)"
      @end="record('toola', 'end', $event)"
      @add="record('toola', 'add', $event)"
      @remove="record('toola', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
        </span>
      </template>
    </SortableList>
    <ol class="state-list state-toola">
      <li r-for="item, index in $data.toola" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <section data-testid="zone-toolb">
    <h4>Toolbar B</h4>
    <SortableList
      r-model:items="$data.toolb"
      itemKey="id"
      group="tools"
      orientation="horizontal"
      listClass="toolbar"
      listLabel="Toolbar B"
      :keyboardTrigger="$data.trigger"
      :handle="$classSelector('grip')"
      @start="record('toolb', 'start', $event)"
      @reorder="record('toolb', 'reorder', $event)"
      @end="record('toolb', 'end', $event)"
      @add="record('toolb', 'add', $event)"
      @remove="record('toolb', 'remove', $event)"
    >
      <template #default="{ item, instructionsId }">
        <span class="row">
          <button type="button" class="grip" :aria-label="'Reorder ' + item.label" :aria-describedby="instructionsId">⋮⋮</button>
          <span class="label">{{ item.label }}</span>
        </span>
      </template>
    </SortableList>
    <ol class="state-list state-toolb">
      <li r-for="item, index in $data.toolb" :key="item.id">{{ item.label }}</li>
    </ol>
  </section>
  <output data-testid="last-end">{{ $data.lastEnd }}</output>
  <output data-testid="end-state">{{ $data.endState }}</output>
  <ol class="event-log">
    <li r-for="entry, index in $data.log" :key="index">{{ entry }}</li>
  </ol>
</div>
</template>

<style>
.zones-demo {
  font-family: system-ui, -apple-system, sans-serif;
  color: #1a1a1a;
  padding: 1rem;
  max-width: 560px;
}
.zones-demo h4 {
  margin: 0.75rem 0 0.25rem;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: rgba(0, 0, 0, 0.55);
}
.controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.3rem 0.5rem;
  background: #f5f5f7;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 6px;
  margin: 0.2rem 0;
}
.grip {
  color: rgba(0, 0, 0, 0.45);
  cursor: grab;
  font-family: monospace;
  background: transparent;
  border: 1px solid rgba(0, 0, 0, 0.15);
  border-radius: 4px;
  padding: 0.1rem 0.4rem;
}
.label { flex: 1; }
.row-input { flex: 1; min-width: 0; font: inherit; }
.grid-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  padding: 0.25rem 0 0.25rem 1.5rem;
}
.zones-demo :deep(.toolbar) { display: flex; gap: 0.25rem; }
.state-list, .event-log { font-size: 0.75rem; margin: 0.25rem 0; }
</style>

</rozie>
