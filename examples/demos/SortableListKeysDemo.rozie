<!--
  SortableListKeysDemo.rozie — behavioral-only fixture for SortableList's
  within-list keyboard keys (Home / End / PageUp / PageDown, Escape revert)
  and the `interaction` field on emitted events.

  One vertical row-mode list, no `group`. The page exposes:
    - the `<ol class="state-list">` sidecar showing the bound array order,
    - an `<ol class="event-log">` with one `li` per emitted event, text
      `${name}:${interaction}`.
  The list has both a `#header` and a `#footer`, so the spec can check that
  every event's `oldIndex` / `newIndex` counts item rows only (on Lit the
  header / footer `<slot>`s are children of the list element too). The last
  `end` payload is shown in `<output data-testid="last-end">` as JSON
  ({ item, el, from, to, oldIndex, newIndex, interaction }, with `item` as
  the item's label, `el` as "element" or null and `from` / `to` as the list's
  aria-label). `<output data-testid="end-order">` shows the ids of the bound
  `items` as an `end` handler read them.
  Controls (the spec clicks them without moving focus):
    - `disable-prop`   toggles the `disabled` prop,
    - `disable-option` calls the imperative `option('disabled', true)`,
    - `prepend`        inserts a new first item (a consumer change mid-lift).
  The list also passes an object `itemClass` and an array-with-object
  `listClass`, so the spec can check those classes land on every target
  (Angular's native [class] used to drop objects nested in a class list).

  NOT a screenshot cell (deliberately absent from matrix.spec.ts EXAMPLES).
-->

<rozie name="SortableListKeysDemo">

<components>
{
  SortableList: '../../packages/ui/sortable-list/src/SortableList.rozie',
}
</components>

<data>
{
  items: [],
  log: [],
  lastEnd: '',
  endOrder: '',
  disabled: false,
}
</data>

<script>
const SEED = () => [
  { id: 'a', label: 'Apple' },
  { id: 'b', label: 'Banana' },
  { id: 'c', label: 'Cherry' },
  { id: 'd', label: 'Date' },
  { id: 'e', label: 'Elderberry' },
]

// Lit delivers a child $emit as a CustomEvent with the payload in `detail`;
// the other targets hand over the payload itself.
const interactionOf = (e) => {
  if (e != null && e.interaction != null) return e.interaction
  if (e != null && e.detail != null && e.detail.interaction != null) return e.detail.interaction
  return '?'
}

const payloadOf = (e) => {
  if (e != null && e.interaction == null && e.detail != null && e.detail.interaction != null) return e.detail
  return e
}

const record = (name, e) => {
  $data.log = [...$data.log, name + ':' + interactionOf(e)]
  const p = payloadOf(e)
  if (name === 'end') {
    // What a consumer `end` handler sees in its own bound array.
    $data.endOrder = $data.items.map((i) => i.id).join(',')
  }
  if (name === 'end' && p != null) {
    $data.lastEnd = JSON.stringify({
      item: p.item != null && p.item.label != null ? p.item.label : null,
      el: p.el == null ? null : 'element',
      from: p.from == null ? null : p.from.getAttribute('aria-label'),
      to: p.to == null ? null : p.to.getAttribute('aria-label'),
      oldIndex: p.oldIndex,
      newIndex: p.newIndex,
      interaction: p.interaction,
    })
  }
}

const toggleDisabled = () => {
  $data.disabled = !$data.disabled
}

const disableByOption = () => {
  $refs.list.option('disabled', true)
}

const prependItem = () => {
  $data.items = [{ id: 'z', label: 'Zucchini' }, ...$data.items]
}

$onMount(() => {
  $data.items = SEED()
})
</script>

<template>
<div class="keys-demo">
  <h4>Keyboard keys</h4>
  <div class="controls">
    <button type="button" data-testid="disable-prop" @click="toggleDisabled">Toggle disabled</button>
    <button type="button" data-testid="disable-option" @click="disableByOption">option('disabled', true)</button>
    <button type="button" data-testid="prepend" @click="prependItem">Prepend</button>
  </div>
  <SortableList
    ref="list"
    r-model:items="$data.items"
    itemKey="id"
    :disabled="$data.disabled"
    :itemClass="{ 'demo-item-flag': true, 'demo-item-off': false }"
    :listClass="['demo-list', { 'demo-list-flag': true }]"
    listLabel="Fruit"
    @start="record('start', $event)"
    @reorder="record('reorder', $event)"
    @end="record('end', $event)"
    @add="record('add', $event)"
    @remove="record('remove', $event)"
  >
    <template #header>
      <div class="list-header">Fruit ({{ $data.items.length }})</div>
    </template>
    <template #default="{ item }">
      <span class="row"><span class="label">{{ item.label }}</span></span>
    </template>
    <template #footer>
      <div class="list-footer">End of list</div>
    </template>
  </SortableList>

  <ol class="state-list">
    <li r-for="item, index in $data.items" :key="item.id">
      <span>{{ item.label }}</span>
    </li>
  </ol>

  <ol class="event-log">
    <li r-for="entry, index in $data.log" :key="index">{{ entry }}</li>
  </ol>
  <output data-testid="last-end">{{ $data.lastEnd }}</output>
  <output data-testid="end-order">{{ $data.endOrder }}</output>
</div>
</template>

<style>
.keys-demo {
  font-family: system-ui, -apple-system, sans-serif;
  padding: 1rem;
  max-width: 480px;
}
.row {
  display: block;
  padding: 0.4rem 0.6rem;
  background: #f5f5f7;
  border-radius: 6px;
  margin: 0.25rem 0;
}
.state-list, .event-log { font-size: 0.8rem; }
</style>

</rozie>
