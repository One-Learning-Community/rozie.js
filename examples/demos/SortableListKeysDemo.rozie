<!--
  SortableListKeysDemo.rozie — behavioral-only fixture for SortableList's
  within-list keyboard keys (Home / End / PageUp / PageDown, Escape revert)
  and the `interaction` field on emitted events.

  One vertical row-mode list, no `group`. The page exposes:
    - the `<ol class="state-list">` sidecar showing the bound array order,
    - an `<ol class="event-log">` with one `li` per emitted event, text
      `${name}:${interaction}`.
  The list has both a `#header` and a `#footer`, so the spec can check that
  every event's `oldIndex` / `newIndex` counts item rows only (header and
  footer render outside the list element on every target). The last
  `end` payload is shown in `<output data-testid="last-end">` as JSON
  ({ item, el, from, to, oldIndex, newIndex, interaction }, with `item` as
  the item's label, `el` as "element" or null and `from` / `to` as the list's
  aria-label). `<output data-testid="end-order">` shows the ids of the bound
  `items` as an `end` handler read them.
  Controls (the spec clicks them without moving focus):
    - `disable-prop`   toggles the `disabled` prop,
    - `disable-option` calls the imperative `option('disabled', true)`,
    - `prepend`        inserts a new first item (a consumer change mid-lift),
    - `disable-keyboard` toggles the `disableKeyboard` prop,
    - `options-disabled` sets the `options` prop to `{ disabled: true }`,
    - `sort-off`       calls the imperative `option('sort', false)`,
    - `draggable-ac`   remounts the list with `options.draggable` matching
                       only Apple's and Cherry's rows,
    - `announce-custom` sets `announcements` to
                       `{ moved: ({ label, position }) => label + ' → ' + position }`,
    - `announce-silent` sets `announcements` to `{ dropped: () => '' }`,
    - `strip-labels`   replaces every item with `{ id, text }` (no `label`
                       field), so the list reads rows by their text.
    - `options-sort-off` sets the `options` prop to `{ sort: false }` WITHOUT
                       a remount (the live `options` watcher must reach
                       SortableJS), `options-clear` sets it back to `{}`,
    - `animation-0`    sets the `animation` prop to 0, and `read-animation`
                       writes the handle's `option('animation')` into
                       `<output data-testid="animation">`,
    - `sort-cae`       calls the imperative `sort(['c', 'a', 'e'])`,
    - `options-animation-0` sets the `options` prop to `{ animation: 0 }`,
      `animation-300` sets the `animation` prop to 300, and
      `option-animation-50` calls the imperative `option('animation', 50)`.
  The list also passes an object `itemClass` and an array-with-object
  `listClass`, so the spec can check those classes land on every target
  (Angular's native [class] used to drop objects nested in a class list).

  NOT a screenshot cell (deliberately absent from matrix.spec.ts EXAMPLES).
-->

<rozie name="SortableListKeysDemo">

<components>
{
  SortableList: '../../packages/ui/sortable-list/src/SortableList.rozie',
}
</components>

<data>
{
  items: [],
  log: [],
  lastEnd: '',
  endOrder: '',
  disabled: false,
  disableKeyboard: false,
  listOptions: {},
  listKey: 0,
  announcements: null,
  animation: 150,
  animationRead: '',
}
</data>

<script>
const SEED = () => [
  { id: 'a', label: 'Apple' },
  { id: 'b', label: 'Banana' },
  { id: 'c', label: 'Cherry' },
  { id: 'd', label: 'Date' },
  { id: 'e', label: 'Elderberry' },
]

// Lit delivers a child $emit as a CustomEvent with the payload in `detail`;
// the other targets hand over the payload itself.
const interactionOf = (e) => {
  if (e != null && e.interaction != null) return e.interaction
  if (e != null && e.detail != null && e.detail.interaction != null) return e.detail.interaction
  return '?'
}

const payloadOf = (e) => {
  if (e != null && e.interaction == null && e.detail != null && e.detail.interaction != null) return e.detail
  return e
}

const record = (name, e) => {
  $data.log = [...$data.log, name + ':' + interactionOf(e)]
  const p = payloadOf(e)
  if (name === 'end') {
    // What a consumer `end` handler sees in its own bound array.
    $data.endOrder = $data.items.map((i) => i.id).join(',')
  }
  if (name === 'end' && p != null) {
    $data.lastEnd = JSON.stringify({
      item: p.item != null ? labelText(p.item) : null,
      el: p.el == null ? null : 'element',
      from: p.from == null ? null : p.from.getAttribute('aria-label'),
      to: p.to == null ? null : p.to.getAttribute('aria-label'),
      oldIndex: p.oldIndex,
      newIndex: p.newIndex,
      interaction: p.interaction,
    })
  }
}

const toggleDisabled = () => {
  $data.disabled = !$data.disabled
}

const disableByOption = () => {
  $refs.list.option('disabled', true)
}

const toggleDisableKeyboard = () => {
  $data.disableKeyboard = !$data.disableKeyboard
}

const disableByOptions = () => {
  $data.listOptions = { disabled: true }
}

const sortOff = () => {
  $refs.list.option('sort', false)
}

// SortableJS reads `options` at construction: remount the list with it.
const draggableAC = () => {
  $data.listOptions = { draggable: '[data-id="a"], [data-id="c"]' }
  $data.listKey = $data.listKey + 1
}

const announceCustom = () => {
  $data.announcements = { moved: ({ label, position }) => label + ' → ' + position }
}

const announceSilent = () => {
  $data.announcements = { dropped: () => '' }
}

const stripLabels = () => {
  $data.items = $data.items.map((i) => ({ id: i.id, text: labelText(i) }))
}

// An item's display text: its `label`, or `text` once the labels are stripped.
const labelText = (item) => (item.label != null ? item.label : item.text)

const sortOffByOptions = () => {
  $data.listOptions = { sort: false }
}

const clearOptions = () => {
  $data.listOptions = {}
}

const animationOptions0 = () => {
  $data.listOptions = { animation: 0 }
}

const animation300 = () => {
  $data.animation = 300
}

const optionAnimation50 = () => {
  $refs.list.option('animation', 50)
}

const animationOff = () => {
  $data.animation = 0
}

const readAnimation = () => {
  $data.animationRead = String($refs.list.option('animation'))
}

const sortCAE = () => {
  $refs.list.sort(['c', 'a', 'e'])
}

const prependItem = () => {
  $data.items = [{ id: 'z', label: 'Zucchini' }, ...$data.items]
}

$onMount(() => {
  $data.items = SEED()
})
</script>

<template>
<div class="keys-demo">
  <h4>Keyboard keys</h4>
  <div class="controls">
    <button type="button" data-testid="disable-prop" @click="toggleDisabled">Toggle disabled</button>
    <button type="button" data-testid="disable-option" @click="disableByOption">option('disabled', true)</button>
    <button type="button" data-testid="prepend" @click="prependItem">Prepend</button>
    <button type="button" data-testid="disable-keyboard" @click="toggleDisableKeyboard">Toggle disableKeyboard</button>
    <button type="button" data-testid="options-disabled" @click="disableByOptions">options.disabled</button>
    <button type="button" data-testid="sort-off" @click="sortOff">option('sort', false)</button>
    <button type="button" data-testid="draggable-ac" @click="draggableAC">options.draggable (Apple, Cherry)</button>
    <button type="button" data-testid="announce-custom" @click="announceCustom">Custom moved text</button>
    <button type="button" data-testid="announce-silent" @click="announceSilent">Silent dropped</button>
    <button type="button" data-testid="strip-labels" @click="stripLabels">Strip labels</button>
    <button type="button" data-testid="options-sort-off" @click="sortOffByOptions">options.sort false</button>
    <button type="button" data-testid="options-clear" @click="clearOptions">options cleared</button>
    <button type="button" data-testid="animation-0" @click="animationOff">animation 0</button>
    <button type="button" data-testid="read-animation" @click="readAnimation">read option('animation')</button>
    <button type="button" data-testid="options-animation-0" @click="animationOptions0">options.animation 0</button>
    <button type="button" data-testid="animation-300" @click="animation300">animation 300</button>
    <button type="button" data-testid="option-animation-50" @click="optionAnimation50">option('animation', 50)</button>
    <button type="button" data-testid="sort-cae" @click="sortCAE">sort(['c', 'a', 'e'])</button>
  </div>
  <SortableList
    ref="list"
    :key="$data.listKey"
    r-model:items="$data.items"
    itemKey="id"
    :disabled="$data.disabled"
    :animation="$data.animation"
    :disableKeyboard="$data.disableKeyboard"
    :options="$data.listOptions"
    :announcements="$data.announcements"
    :itemClass="{ 'demo-item-flag': true, 'demo-item-off': false }"
    :listClass="['demo-list', { 'demo-list-flag': true }]"
    listLabel="Fruit"
    @start="record('start', $event)"
    @reorder="record('reorder', $event)"
    @end="record('end', $event)"
    @add="record('add', $event)"
    @remove="record('remove', $event)"
  >
    <template #header>
      <div class="list-header">Fruit ({{ $data.items.length }})</div>
    </template>
    <template #default="{ item }">
      <span class="row"><span class="label">{{ labelText(item) }}</span></span>
    </template>
    <template #footer>
      <div class="list-footer">End of list</div>
    </template>
  </SortableList>

  <ol class="state-list">
    <li r-for="item, index in $data.items" :key="item.id">
      <span>{{ labelText(item) }}</span>
    </li>
  </ol>

  <ol class="event-log">
    <li r-for="entry, index in $data.log" :key="index">{{ entry }}</li>
  </ol>
  <output data-testid="last-end">{{ $data.lastEnd }}</output>
  <output data-testid="end-order">{{ $data.endOrder }}</output>
  <output data-testid="animation">{{ $data.animationRead }}</output>
</div>
</template>

<style>
.keys-demo {
  font-family: system-ui, -apple-system, sans-serif;
  padding: 1rem;
  max-width: 480px;
}
.row {
  display: block;
  padding: 0.4rem 0.6rem;
  background: #f5f5f7;
  border-radius: 6px;
  margin: 0.25rem 0;
}
.state-list, .event-log { font-size: 0.8rem; }
</style>

</rozie>
