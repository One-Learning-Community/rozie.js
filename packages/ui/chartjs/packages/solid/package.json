{
  "name": "@rozie-ui/chartjs-solid",
  "version": "0.1.13",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "Idiomatic Solid chart component — one Rozie source compiled to Solid wrapping Chart.js.",
  "keywords": [
    "rozie",
    "rozie-ui",
    "chartjs",
    "chart",
    "charts",
    "data-visualization",
    "component",
    "solid"
  ],
  "author": "One Learning Community (https://github.com/One-Learning-Community)",
  "homepage": "https://github.com/One-Learning-Community/rozie.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/One-Learning-Community/rozie.js.git",
    "directory": "packages/ui/chartjs/packages/solid"
  },
  "bugs": {
    "url": "https://github.com/One-Learning-Community/rozie.js/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "solid": "./dist/source/index.jsx",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.mts",
      "solid": "./dist/source/auto.jsx",
      "import": "./dist/auto.mjs",
      "require": "./dist/auto.cjs"
    },
    "./line": {
      "types": "./dist/Line.d.mts",
      "solid": "./dist/source/Line.jsx",
      "import": "./dist/Line.mjs",
      "require": "./dist/Line.cjs"
    },
    "./bar": {
      "types": "./dist/Bar.d.mts",
      "solid": "./dist/source/Bar.jsx",
      "import": "./dist/Bar.mjs",
      "require": "./dist/Bar.cjs"
    },
    "./pie": {
      "types": "./dist/Pie.d.mts",
      "solid": "./dist/source/Pie.jsx",
      "import": "./dist/Pie.mjs",
      "require": "./dist/Pie.cjs"
    },
    "./doughnut": {
      "types": "./dist/Doughnut.d.mts",
      "solid": "./dist/source/Doughnut.jsx",
      "import": "./dist/Doughnut.mjs",
      "require": "./dist/Doughnut.cjs"
    },
    "./polar-area": {
      "types": "./dist/PolarArea.d.mts",
      "solid": "./dist/source/PolarArea.jsx",
      "import": "./dist/PolarArea.mjs",
      "require": "./dist/PolarArea.cjs"
    },
    "./radar": {
      "types": "./dist/Radar.d.mts",
      "solid": "./dist/source/Radar.jsx",
      "import": "./dist/Radar.mjs",
      "require": "./dist/Radar.cjs"
    },
    "./scatter": {
      "types": "./dist/Scatter.d.mts",
      "solid": "./dist/source/Scatter.jsx",
      "import": "./dist/Scatter.mjs",
      "require": "./dist/Scatter.cjs"
    },
    "./bubble": {
      "types": "./dist/Bubble.d.mts",
      "solid": "./dist/source/Bubble.jsx",
      "import": "./dist/Bubble.mjs",
      "require": "./dist/Bubble.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@rozie/runtime-solid": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8",
    "chart.js": "^4"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": false
    },
    "chart.js": {
      "optional": false
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "babel-preset-solid": "~1.8.22"
  }
}
