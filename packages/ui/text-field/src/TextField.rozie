<!--
  TextField.rozie — an accessible single-line or multiline text field with its
  own label, description, error message and character counter.

  A pure-Rozie family (NO third-party engine). A native <input> or <textarea>
  already binds well in every framework, so the value here is the FIELD around
  it: the label / description / error wiring (`for`, `aria-describedby`,
  `aria-invalid`), the two-way `modelValue` binding (the Angular
  ControlValueAccessor), token theming, and opt-in textarea autosize.

  WHY THE CONTROL IS INSIDE (not a generic <Field> around a slotted control): on
  Lit the component renders in a shadow root, and id references (`<label for>`,
  `aria-describedby`) do not cross a shadow boundary. A slotted light-DOM input
  could not be labelled by a shadow-root <label>, so a generic wrapper would be
  broken on one of the six targets. With the control inside, every id reference
  resolves within one tree on all six.

  IDS: `<idBase>-input` / `-description` / `-error` / `-count`. An empty `idBase`
  (the default) gets a unique `rozie-text-field-<n>` after mount from the page-wide
  counter Combobox / Listbox / Popover share.

  Authoring notes (collision classes — see the authoring playbook §6):
    - No top-level binding is named `value` / `id` / `title` / `inputMode` /
      `select` (Lit class-field collisions with inherited DOM members). The
      exposed verb `select` is fine: HTMLElement has no `select()`. The focus verb
      is `focus` — a deliberate, signature-compatible override of
      HTMLElement.focus on Lit (ROZ137 warns, accepted; the otp/number-field
      precedent).
    - The model write funnel is `commitText`, NOT `writeValue` (the generated
      Angular ControlValueAccessor method, TS2300).
    - Handler params are untyped (neutralize to `any`) so `e.target.value` /
      `e.key` typecheck on all six strict leaves.
    - `$refs.inputEl` / `$refs.textareaEl` are read only in $onMount, handlers,
      the $watch callback and $expose verbs (post-mount, ROZ123-safe). They type
      as a generic HTMLElement on several leaves, so input-only members
      (`select()`) go through an `any` local.
    - Derived strings are plain functions called `()` (read in the template AND
      in handlers), never `$computed`.

  Consumer example:

    <TextField r-model:modelValue="$data.email" label="Email" type="email"
               description="We never share it." :error="$data.emailError" required />
-->

<rozie name="TextField">

<types>
/** The `change` and `enter` event payload: the field's current text. */
export interface TextFieldValuePayload { value: string }
</types>

<props>
{
  modelValue: {
    type: String,
    default: '',
    model: true,
    docs: {
      description:
        'The text in the field (two-way `r-model`). As the sole `model: true` prop it drives the Angular `ControlValueAccessor`, so `[(ngModel)]` and `[formControl]` bind directly. Written on every keystroke.',
      example: '<TextField r-model:modelValue="email" label="Email" />',
    },
  },

  label: {
    type: String,
    default: '',
    docs: {
      description:
        'Visible label text, rendered as a `<label>` whose `for` points at the control. Leave it empty and set `ariaLabel` when the field has no visible label.',
    },
  },

  description: {
    type: String,
    default: '',
    docs: {
      description:
        'Help text shown under the control and linked to it through `aria-describedby`, so screen readers announce it after the label.',
    },
  },

  error: {
    type: String,
    default: '',
    docs: {
      description:
        'Error message. A non-empty value renders it under the control, links it through `aria-describedby`, and marks the control `aria-invalid="true"`. Clear it (empty string) once the value is valid again.',
      example: '<TextField r-model:modelValue="email" label="Email" :error="emailError" />',
    },
  },

  invalid: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Mark the field invalid (`aria-invalid="true"` and the invalid styling) without showing a message, for example when the message is rendered elsewhere. A non-empty `error` implies this.',
    },
  },

  type: {
    type: String,
    default: 'text',
    docs: {
      description:
        "The native input `type`: `'text'`, `'email'`, `'password'`, `'search'`, `'tel'` or `'url'`. Ignored when `multiline` is set.",
    },
  },

  placeholder: {
    type: String,
    default: '',
    docs: {
      description:
        'Placeholder text shown while the field is empty. It is not a substitute for `label`: it disappears on input and many screen readers do not announce it.',
    },
  },

  name: {
    type: String,
    default: '',
    docs: {
      description:
        'The native `name` attribute, used when the field sits in a plain HTML `<form>`. On Lit the control is in a shadow root, so it does not join the outer form; bind `modelValue` there.',
    },
  },

  autocomplete: {
    type: String,
    default: '',
    docs: {
      description:
        "The native `autocomplete` hint (e.g. `'email'`, `'current-password'`, `'off'`). Empty leaves the browser default.",
    },
  },

  required: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Mark the field required: sets the native `required` attribute (announced by screen readers) and shows a `*` after the label. The marker is `aria-hidden` so it is not read twice.',
    },
  },

  disabled: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Disable the control. Also sets the Angular `ControlValueAccessor` disabled state.',
    },
  },

  readonly: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Make the control read-only: the text is shown, focusable and selectable but cannot be edited.',
    },
  },

  maxLength: {
    type: Number,
    default: null,
    docs: {
      description:
        'Maximum number of characters, forwarded as the native `maxlength`. `null` (the default) means no limit. With `showCount`, the counter reads `n / maxLength`.',
    },
  },

  showCount: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Show a character counter under the control (`n / maxLength`, or just `n` without a limit). The counter is linked through `aria-describedby`; it is not a live region, so it does not interrupt typing.',
    },
  },

  multiline: {
    type: Boolean,
    default: false,
    docs: {
      description: 'Render a `<textarea>` instead of an `<input>`.',
    },
  },

  rows: {
    type: Number,
    default: 3,
    docs: {
      description:
        'Visible rows of a `multiline` field (the native `rows`). With `autosize` it is the minimum height.',
    },
  },

  autosize: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Grow a `multiline` field to fit its content, from `rows` up to `maxRows`. It re-measures on input, on programmatic `modelValue` changes and when the field width changes.',
      example: '<TextField r-model:modelValue="notes" label="Notes" multiline autosize :maxRows="8" />',
    },
  },

  maxRows: {
    type: Number,
    default: null,
    docs: {
      description:
        'The tallest an `autosize` field grows, in rows; past it the textarea scrolls. `null` (the default) means no cap.',
    },
  },

  ariaLabel: {
    type: String,
    default: null,
    docs: {
      description:
        'Accessible name for the control (`aria-label`) when there is no visible `label`.',
    },
  },

  idBase: {
    type: String,
    default: '',
    docs: {
      description:
        "Id base for the control and its text: the control is `idBase + '-input'`, and the description, error and counter are `-description`, `-error` and `-count`. Leave it empty (the default) and each instance generates a unique base after mount (`rozie-text-field-<n>`); set it when you need stable ids, for example to point an external element at the control. Named `idBase` (not `id`) to avoid shadowing `HTMLElement.id` on the Lit custom element.",
    },
  },
}
</props>

<emits>
{
  change: { payload: 'TextFieldValuePayload', docs: { description: 'Fired when the user commits an edit: on blur, when the text differs from what it was when the field gained focus. The payload is `{ value }`. Use `modelValue` for every keystroke.' } },
  enter: { payload: 'TextFieldValuePayload', docs: { description: 'Fired when the user presses Enter in a single-line field (not while an IME composition is open). The payload is `{ value }`. The key is not prevented, so an enclosing form still submits.' } },
}
</emits>

<data>
{
  // The generated id base, set once in $onMount when `idBase` is empty.
  autoId: '',
}
</data>

<script lang="ts">
import { applyAutosize } from './internal/autosize'

// Top-level so React hoists it to a ref and the Solid onMount/onCleanup split
// sees it in teardown.
let widthObserver: any = null
let observedEl: any = null
let lastWidth = -1
// Whether fit() has written an inline height, so turning `autosize` off can
// remove it (and never touches a height the user set with the resize grip).
let autosized = false
// The rows the last fit() used, read by the width observer. The observer
// re-applies through these instead of calling fit(): two helpers calling each
// other are a use-before-declaration error in React's useCallback dep arrays.
let fitRows: any = null
let fitMaxRows: any = null
// The text when the control gained focus, and whether the user has typed since.
// `change` fires on blur only for a user edit that changed the text, so a
// programmatic write (clear(), a consumer reformatting the value) never does.
let textAtFocus = ''
let editedSinceFocus = false

// The page-wide id counter (the same four lines as Combobox / Listbox / Popover).
const nextAutoId = () => {
  const n = (Number(Reflect.get(globalThis, '__rozieAutoId')) || 0) + 1
  Reflect.set(globalThis, '__rozieAutoId', n)
  return n
}

// ---- ids -------------------------------------------------------------------
const idRoot = () => $props.idBase || $data.autoId || 'rozie-text-field'
const inputId = () => idRoot() + '-input'
const descriptionId = () => idRoot() + '-description'
const errorId = () => idRoot() + '-error'
const countId = () => idRoot() + '-count'

// ---- derived state ---------------------------------------------------------
const hasError = () => typeof $props.error === 'string' && $props.error.length > 0
const isInvalid = () => !!$props.invalid || hasError()
const currentText = () => ($props.modelValue == null ? '' : String($props.modelValue))
// Read once into a local: Angular does not narrow across two signal calls.
const hasLimit = () => {
  const limit = $props.maxLength
  return typeof limit === 'number' && limit >= 0
}

const countText = () => {
  const n = currentText().length
  return hasLimit() ? n + ' / ' + $props.maxLength : String(n)
}

// The ids of the rendered helper text, space-joined, or null when there is none.
const describedBy = () => {
  const ids: string[] = []
  if ($props.description) ids.push(descriptionId())
  if (hasError()) ids.push(errorId())
  if ($props.showCount) ids.push(countId())
  return ids.length > 0 ? ids.join(' ') : null
}

const inputType = () => ($props.type ? $props.type : 'text')

// An optional string attribute: omitted when empty. Untyped param → `any`, so it
// feeds strict DOM attribute types on every target (Vue's `string | undefined`,
// Svelte's closed `autocomplete` union) without a per-target cast.
const optionalAttr = (v) => (v ? v : undefined)

// ---- autosize --------------------------------------------------------------
// A width change re-wraps the text, so an autosized textarea is observed and
// re-measured. Only a WIDTH change counts: our own height write must not loop
// the observer. Re-targets when the textarea is (re)mounted by `multiline`.
const observeWidth = (el) => {
  if (el === observedEl) return
  if (widthObserver) widthObserver.disconnect()
  widthObserver = null
  observedEl = el
  lastWidth = -1
  if (!el || typeof ResizeObserver === 'undefined') return
  widthObserver = new ResizeObserver((entries) => {
    const w = entries[0] ? entries[0].contentRect.width : -1
    if (w === lastWidth) return
    lastWidth = w
    applyAutosize(observedEl, fitRows, fitMaxRows)
  })
  widthObserver.observe(el)
}

const fit = () => {
  const el = $props.multiline ? $refs.textareaEl : null
  if (!el || !$props.autosize) {
    observeWidth(null)
    if (el && autosized) {
      el.style.height = ''
      el.style.overflowY = ''
    }
    autosized = false
    return
  }
  fitRows = $props.rows
  fitMaxRows = $props.maxRows
  observeWidth(el)
  applyAutosize(el, fitRows, fitMaxRows)
  autosized = true
}

// Re-measure once every target has rendered the change: a macrotask, because
// Lit applies its update in a microtask of its own.
const fitLater = () => {
  setTimeout(() => fit(), 0)
}

// ---- handlers --------------------------------------------------------------
// Named commitText, NOT writeValue (the generated Angular CVA method).
const commitText = (text) => {
  $model.modelValue = text
}

const onInput = (e) => {
  editedSinceFocus = true
  commitText(e && e.target ? e.target.value : '')
  fit()
}

// `change` = a committed edit: on blur, when the text differs from what it was
// at focus. Driven from focus/blur rather than the native `change` event because
// React's `onChange` (what `@change` lowers to there) fires on every keystroke,
// so the native event would not mean the same thing on all six targets.
const onFocus = (e) => {
  textAtFocus = e && e.target ? e.target.value : currentText()
  editedSinceFocus = false
}

const onBlur = (e) => {
  const text = e && e.target ? e.target.value : currentText()
  const changed = editedSinceFocus && text !== textAtFocus
  editedSinceFocus = false
  textAtFocus = text
  if (changed) $emit('change', { value: text })
}

const onKeydown = (e) => {
  if (!e || e.key !== 'Enter' || e.isComposing) return
  $emit('enter', { value: e.target ? e.target.value : currentText() })
}

// ---- lifecycle -------------------------------------------------------------
$onMount(() => {
  if (!$props.idBase) $data.autoId = 'rozie-text-field-' + nextAutoId()
  fit()
  return () => {
    observeWidth(null)
  }
})

// A programmatic modelValue write changes the text without an input event, and
// the autosize props can change at runtime (`multiline` swaps the control).
$watch(() => $props.modelValue, () => fitLater())
$watch(() => $props.multiline, () => fitLater())
$watch(() => $props.autosize, () => fitLater())
$watch(() => $props.rows, () => fitLater())
$watch(() => $props.maxRows, () => fitLater())

// ---- imperative handle -----------------------------------------------------
const control = () => ($props.multiline ? $refs.textareaEl : $refs.inputEl)

// focus() deliberately overrides HTMLElement.focus on Lit (ROZ137, accepted).
const focus = () => {
  const el = control()
  if (el && el.focus) el.focus()
}

// select() — focus the control and select all of its text.
const select = () => {
  const el: any = control()
  if (!el) return
  if (el.focus) el.focus()
  if (el.select) el.select()
}

// clear() — empty the field (writes modelValue = '').
const clear = () => {
  commitText('')
  fit()
}

$expose({ focus, select, clear }, { focus: '() => void', select: '() => void', clear: '() => void' })
</script>

<template>
<div
  class="rozie-text-field"
  :class="{ 'rozie-text-field--invalid': isInvalid(), 'rozie-text-field--disabled': $props.disabled, 'rozie-text-field--multiline': $props.multiline, 'rozie-text-field--autosize': $props.multiline && $props.autosize }"
>
  <label r-if="$props.label" class="rozie-text-field-label" :for="inputId()">{{ $props.label }}<span r-if="$props.required" class="rozie-text-field-required" aria-hidden="true">*</span></label>

  <div class="rozie-text-field-control">
    <span r-if="$slots.prefix" class="rozie-text-field-prefix"><slot name="prefix" /></span>

    <textarea
      r-if="$props.multiline"
      ref="textareaEl"
      class="rozie-text-field-input"
      :id="inputId()"
      :value="currentText()"
      :rows="$props.rows"
      :name="optionalAttr($props.name)"
      :placeholder="optionalAttr($props.placeholder)"
      :autocomplete="optionalAttr($props.autocomplete)"
      :maxlength="$props.maxLength"
      :required="!!$props.required"
      :disabled="!!$props.disabled"
      :readonly="!!$props.readonly"
      :aria-label="$props.ariaLabel"
      :aria-invalid="isInvalid() ? 'true' : null"
      :aria-describedby="describedBy()"
      @input="onInput($event)"
      @focus="onFocus($event)"
      @blur="onBlur($event)"
    ></textarea>

    <input
      r-if="!$props.multiline"
      ref="inputEl"
      class="rozie-text-field-input"
      :id="inputId()"
      :type="inputType()"
      :value="currentText()"
      :name="optionalAttr($props.name)"
      :placeholder="optionalAttr($props.placeholder)"
      :autocomplete="optionalAttr($props.autocomplete)"
      :maxlength="$props.maxLength"
      :required="!!$props.required"
      :disabled="!!$props.disabled"
      :readonly="!!$props.readonly"
      :aria-label="$props.ariaLabel"
      :aria-invalid="isInvalid() ? 'true' : null"
      :aria-describedby="describedBy()"
      @input="onInput($event)"
      @focus="onFocus($event)"
      @blur="onBlur($event)"
      @keydown="onKeydown($event)"
    />

    <span r-if="$slots.suffix" class="rozie-text-field-suffix"><slot name="suffix" /></span>
  </div>

  <p r-if="$props.description" class="rozie-text-field-description" :id="descriptionId()">{{ $props.description }}</p>
  <p r-if="hasError()" class="rozie-text-field-error" :id="errorId()">{{ $props.error }}</p>
  <p r-if="$props.showCount" class="rozie-text-field-count" :id="countId()">{{ countText() }}</p>
</div>
</template>

<style>
/*
  Token-driven (the dialog/otp convention): every cosmetic value is a
  `var(--rozie-text-field-*, var(--rtf-*, <fallback>))`. The shipped themes/*.css
  presets map these onto shadcn/Radix, Material 3 and Bootstrap 5.
*/
.rozie-text-field {
  display: flex;
  flex-direction: column;
  gap: var(--rozie-text-field-gap, var(--rtf-gap, 0.375rem));
  font: var(--rozie-text-field-font, inherit);
  color: var(--rozie-text-field-color, var(--rtf-color, inherit));
  width: var(--rozie-text-field-width, var(--rtf-width, 100%));
  min-width: 0;
}

.rozie-text-field-label {
  font-size: var(--rozie-text-field-label-size, var(--rtf-label-size, 0.875rem));
  font-weight: var(--rozie-text-field-label-weight, var(--rtf-label-weight, 500));
  color: var(--rozie-text-field-label-color, var(--rtf-label-color, inherit));
}

.rozie-text-field-required {
  /* A margin, not a leading space in the markup: targets collapse that space differently. */
  margin-left: 0.25em;
  color: var(--rozie-text-field-error-color, var(--rtf-error-color, #dc2626));
}

.rozie-text-field-control {
  display: flex;
  align-items: center;
  gap: var(--rozie-text-field-adornment-gap, var(--rtf-adornment-gap, 0.5rem));
  box-sizing: border-box;
  padding: 0 var(--rozie-text-field-padding-x, var(--rtf-padding-x, 0.75rem));
  border: var(--rozie-text-field-border-width, var(--rtf-border-width, 1px)) solid var(--rozie-text-field-border-color, var(--rtf-border-color, rgba(0, 0, 0, 0.25)));
  border-radius: var(--rozie-text-field-radius, var(--rtf-radius, 0.5rem));
  background: var(--rozie-text-field-bg, var(--rtf-bg, #fff));
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.rozie-text-field--multiline .rozie-text-field-control {
  align-items: flex-start;
}

.rozie-text-field-control:focus-within {
  border-color: var(--rozie-text-field-focus-color, var(--rtf-focus-color, #2563eb));
  box-shadow: 0 0 0 var(--rozie-text-field-focus-ring-width, var(--rtf-focus-ring-width, 3px)) var(--rozie-text-field-focus-ring, var(--rtf-focus-ring, rgba(37, 99, 235, 0.25)));
}

.rozie-text-field--invalid .rozie-text-field-control {
  border-color: var(--rozie-text-field-error-color, var(--rtf-error-color, #dc2626));
}

.rozie-text-field--invalid .rozie-text-field-control:focus-within {
  box-shadow: 0 0 0 var(--rozie-text-field-focus-ring-width, var(--rtf-focus-ring-width, 3px)) var(--rozie-text-field-error-ring, var(--rtf-error-ring, rgba(220, 38, 38, 0.25)));
}

/* Keyed on the native :disabled state (not the --disabled class) so an Angular
   form-level disable (setDisabledState) styles the same as the `disabled` prop. */
.rozie-text-field-control:has(> .rozie-text-field-input:disabled) {
  background: var(--rozie-text-field-disabled-bg, var(--rtf-disabled-bg, rgba(0, 0, 0, 0.04)));
  opacity: var(--rozie-text-field-disabled-opacity, var(--rtf-disabled-opacity, 0.6));
}

.rozie-text-field-input {
  flex: 1 1 auto;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: var(--rozie-text-field-padding-y, var(--rtf-padding-y, 0.5rem)) 0;
  border: 0;
  outline: none;
  background: transparent;
  font: inherit;
  color: inherit;
  line-height: var(--rozie-text-field-line-height, var(--rtf-line-height, 1.5));
}

textarea.rozie-text-field-input {
  resize: var(--rozie-text-field-resize, var(--rtf-resize, vertical));
}

/* An autosized textarea sizes itself; a manual resize grip would fight it. */
.rozie-text-field--autosize textarea.rozie-text-field-input {
  resize: none;
}

.rozie-text-field-input::placeholder {
  color: var(--rozie-text-field-placeholder-color, var(--rtf-placeholder-color, rgba(0, 0, 0, 0.45)));
}

.rozie-text-field-input:disabled {
  cursor: not-allowed;
}

.rozie-text-field-prefix,
.rozie-text-field-suffix {
  display: inline-flex;
  align-items: center;
  flex: none;
  color: var(--rozie-text-field-adornment-color, var(--rtf-adornment-color, rgba(0, 0, 0, 0.55)));
}

.rozie-text-field--multiline .rozie-text-field-prefix,
.rozie-text-field--multiline .rozie-text-field-suffix {
  padding-top: var(--rozie-text-field-padding-y, var(--rtf-padding-y, 0.5rem));
}

.rozie-text-field-description,
.rozie-text-field-error,
.rozie-text-field-count {
  margin: 0;
  font-size: var(--rozie-text-field-help-size, var(--rtf-help-size, 0.8125rem));
}

.rozie-text-field-description {
  color: var(--rozie-text-field-description-color, var(--rtf-description-color, rgba(0, 0, 0, 0.6)));
}

.rozie-text-field-error {
  color: var(--rozie-text-field-error-color, var(--rtf-error-color, #dc2626));
}

.rozie-text-field-count {
  align-self: flex-end;
  color: var(--rozie-text-field-description-color, var(--rtf-description-color, rgba(0, 0, 0, 0.6)));
  font-variant-numeric: tabular-nums;
}
</style>

</rozie>
