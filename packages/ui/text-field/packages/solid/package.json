{
  "name": "@rozie-ui/text-field-solid",
  "version": "0.1.1",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "Idiomatic Solid accessible text field and textarea: label, description and error wired through for / aria-describedby / aria-invalid, two-way binding, a character counter and opt-in autosize — one Rozie source compiled to Solid.",
  "keywords": [
    "rozie",
    "rozie-ui",
    "text-field",
    "input",
    "textarea",
    "form",
    "autosize",
    "accessibility",
    "aria",
    "component",
    "solid"
  ],
  "author": "One Learning Community (https://github.com/One-Learning-Community)",
  "homepage": "https://github.com/One-Learning-Community/rozie.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/One-Learning-Community/rozie.js.git",
    "directory": "packages/ui/text-field/packages/solid"
  },
  "bugs": {
    "url": "https://github.com/One-Learning-Community/rozie.js/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "solid": "./dist/source/index.jsx",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./source": "./src/TextField.tsx",
    "./themes/*": "./src/themes/*"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@rozie/runtime-solid": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": false
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "babel-preset-solid": "~1.8.22"
  }
}
