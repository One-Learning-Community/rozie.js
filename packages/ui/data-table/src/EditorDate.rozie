<!--
  EditorDate.rozie — presentational #editor slot DROP-IN for @rozie-ui/data-table.

  A ready-made NATIVE <input
 type="date"> cell-editor (ZERO new dependencies — no
  flatpickr/engine) matching the headless built-in editor chrome
  (class="rdt-cell-editor" + bare data-editing-cell). The native date input's value
  is already an ISO `YYYY-MM-DD` string, so the draft IS the ISO string committed.

  Behavior: local draft seeded from $props.value (setup-once); @change/@input
  update the draft only (deferred commit); Enter / blur commit the ISO string;
  Escape cancels.

  PRESENTATIONAL ONLY: NO $emit / NO $expose / NO $inject / NO engine. See
  EditorText.rozie for slot-wiring + styling rationale. NO <style> block.
-->
<rozie name="EditorDate" inherit-attrs="false" inherit-listeners="false">

<props>
{
  columnId: {
    type: String,
    default: '',
    docs: {
      description:
        'The column id (mirrors the `#editor` slot scope). Used as the input `aria-label`.',
    },
  },
  column:   {
    type: null,
    default: null,
    docs: {
      description:
        'The table-core column object (opaque passthrough from the `#editor` slot scope).',
    },
  },
  row:      {
    type: null,
    default: null,
    docs: {
      description:
        "The consumer's row data object (opaque passthrough from the `#editor` slot scope).",
    },
  },
  value:    {
    type: null,
    default: null,
    docs: {
      description:
        'The current cell value the local draft seeds from (setup-once); String-coerced to an ISO `YYYY-MM-DD` string for the native date input.',
    },
  },
  commit:   {
    type: Function,
    default: null,
    docs: {
      description:
        '`(value) => void` — commit the cell with the ISO `YYYY-MM-DD` string (Enter / blur). Null-guarded at call sites.',
    },
  },
  cancel:   {
    type: Function,
    default: null,
    docs: {
      description:
        '`() => void` — revert the edit (Escape). Null-guarded at call sites.',
    },
  },
  // C-02 / editor-owns-focus contract (quick 260711-i5m): the HOST sets this reactively
  // for the ONE editor that should currently hold focus — the drop-in focuses its OWN
  // control in response (mount-time via $onMount, post-mount via a lazy $watch). No
  // shadow-piercing, no host DOM reach-in.
  autofocus: {
    type: Boolean,
    default: false,
    docs: {
      description:
        "Focus this editor's primary control when true — the host sets it for the one editor that should hold focus; reactive.",
    },
  },
  // C-11 — the column's human header, forwarded by the host's slot scope. `column` is an
  // OPAQUE passthrough (`type: null`), so reaching into `column.columnDef.header` is
  // unsound under the leaves' strict tsc — the host owns `headerLabel()` and hands the
  // resolved string down instead of making every drop-in introspect table-core.
  columnLabel: {
    type: String,
    default: '',
    docs: {
      description:
        "The column's human header, forwarded by the slot scope — used as the control's accessible name in place of the internal column id.",
    },
  },
}
</props>

<data>
{
  // Local draft — the native date value is an ISO `YYYY-MM-DD` string.
  draft: '',
}
</data>

<script lang="ts">
// Seed the draft once from the incoming value (setup-once). A native date input
// only accepts `YYYY-MM-DD`; normalize null/undefined to ''.
$data.draft = $props.value != null ? String($props.value) : ''

const onInput = (e) => {
  $data.draft = e && e.target ? e.target.value : ''
}

const doCommit = () => {
  // commit the ISO date string the native control already produced.
  $props.commit && $props.commit($data.draft)
}
const doCancel = () => {
  $props.cancel && $props.cancel()
}

const onChange = (e) => {
  $data.draft = e && e.target ? e.target.value : ''
}

const onKeydown = (e) => {
  if (e && e.key === 'Enter') {
    e.preventDefault()
    doCommit()
  } else if (e && e.key === 'Escape') {
    e.preventDefault()
    doCancel()
  }
}

const onBlur = () => {
  doCommit()
}

// C-11 — the accessible name must be the column's HUMAN header, not its internal id.
// `columnId` is a lookup key (`unit_price`, `col_3`); a screen reader announcing it is
// reading an implementation detail aloud. table-core keeps the authored header on
// `column.columnDef.header`, which is a string for every declarative `<Column header>`;
// a header rendered by a function has no static text, so fall back to the id rather
// than invent one.
const a11yLabel = () => {
  if (typeof $props.columnLabel === 'string' && $props.columnLabel !== '') return $props.columnLabel
  return $props.columnId
}

// C-02 / editor-owns-focus: focus OUR OWN control when the host says we should hold it.
// $onMount covers the initial open (autofocus is already true on first render); the LAZY
// $watch (NOT { immediate: true } — an immediate watch fires PRE-mount and sees a null
// ref on Lit/Solid) covers a REACTIVE refocus while already mounted, e.g. a row-mode
// validation failure flipping autofocus back onto this already-open drop-in.
$onMount(() => {
  if ($props.autofocus) $refs.inputEl?.focus()
})
$watch(() => $props.autofocus, (v) => {
  if (v) $refs.inputEl?.focus()
})
</script>

<template>
<input
  ref="inputEl"
  class="rdt-cell-editor"
  type="date"
  data-editing-cell
  :aria-label="a11yLabel()"
  :value="$data.draft"
  @input="onInput($event)"
  @change="onChange($event)"
  @keydown="onKeydown($event)"
  @blur="onBlur()"
/>
</template>

</rozie>
