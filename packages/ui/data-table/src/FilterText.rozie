<!--
  FilterText.rozie — presentational #filter slot DROP-IN for @rozie-ui/data-table.

  A ready-made text COLUMN-filter input that visually matches the headless built-in
  per-column filter (class="rdt-col-filter"). Consumers fill the parent's #filter
  scoped slot with it:

    <DataTable …>
      <template #filter="{ columnId, column, value, setFilter }">
        <FilterText :columnId="columnId" :column="column"
                    :value="value" :setFilter="setFilter" />
      </template>
    </DataTable>

  PRESENTATIONAL ONLY: NO $emit / NO $expose / NO $inject / NO engine. It receives
  the slot scope props (columnId + the setFilter function prop) and calls them.
  Because the drop-in lives in the consumer's slot, it owns its OWN Enter/Escape
  keymap: Enter / blur applies the filter, Escape clears it.

  Behavior: local draft in $data, seeded once from $props.value in setup-once
  <script>; @input updates the draft; Enter → setFilter(columnId, draft);
  blur → setFilter(columnId, draft); Escape → setFilter(columnId, '') (clears).

  Styling: ZERO CSS of its own. `.rdt-col-filter` is the descendant selector
  `.rozie-data-table-wrap .rdt-col-filter` defined ONLY in DataTable.rozie's
  <style>; a slotted <FilterText> renders INSIDE that subtree so DOM nesting
  reaches that selector. NO <style> block here.
-->
<rozie name="FilterText" inherit-attrs="false" inherit-listeners="false">

<props>
{
  // The column id (mirrors the #filter slot scope) — used as the filter key + an
  // aria-label fallback.
  columnId:  {
    type: String,
    default: '',
    docs: {
      description:
        'The column id (mirrors the `#filter` slot scope) — used as the filter key and the input `aria-label`.',
    },
  },
  // The table-core column object (opaque passthrough).
  column:    {
    type: null,
    default: null,
    docs: {
      description:
        'The table-core column object (opaque passthrough from the `#filter` slot scope).',
    },
  },
  // The current column filter value the input seeds from.
  value:     {
    type: null,
    default: null,
    docs: {
      description:
        'The current column filter value the local draft seeds from (setup-once).',
    },
  },
  // (columnId, value) => void — apply the column filter. Null-guarded at call sites.
  setFilter: {
    type: Function,
    default: null,
    docs: {
      description:
        '`(columnId, value) => void` — apply the column filter (Enter / blur applies, Escape clears). Null-guarded at call sites.',
    },
  },
  // C-11 — the human column header, supplied by the host's #filter slot scope. The filter
  // scope declares no `column`, so this is how a filter drop-in learns its accessible name;
  // falls back to `column.columnDef.header` then `columnId` when a consumer omits it.
  columnLabel: {
    type: String,
    default: '',
    docs: {
      description:
        "The column's human header, forwarded by the `#filter` slot scope — used as the control's accessible name in place of the internal column id.",
    },
  },
}
</props>

<data>
{
  // Local editing draft so the user can type before applying the filter.
  draft: '',
  // C-08/N-04: has the user typed in this input since the incoming value last changed?
  // Until they have, the control reads `$props.value` live (see `draftValue` in the script block).
  touched: false,
}
</data>

<script lang="ts">
// ── C-08 + N-04: the draft is DERIVED from `$props.value`, with a `touched` latch ────────
//
// C-08 — this component mounts once per rendered filter row and is NOT remounted when the
// filter changes, and its draft was seeded setup-once. So a programmatic reset (a "Clear
// filters" button, `setFilter(id, '')` from another control, a consumer writing
// `columnFilters` directly) moved the real filter while this input went on displaying the old
// text: the UI stated a filter that was no longer applied. `FilterSelect` was never affected —
// it reads `$props.value` live through `selectValue()`, which is the pattern adopted here.
//
// N-04 — the setup-once seed was ALSO wrong on Angular from the start: the emitter places
// setup-once statements in the CONSTRUCTOR, where an `input()` signal still returns its
// DEFAULT, because Angular sets inputs after construction. Measured on the sibling EditorDate,
// which opened empty on angular for every row while vue and lit seeded correctly. A derived
// read is correct on all six by construction, with no flash and no per-target branch.
//
// `touched` is what stops the live read from overwriting the user mid-type; the watch clears
// it, so an OUTSIDE change always wins and the input follows it. `@input` never moves
// `$props.value` (nothing is applied until Enter/blur), so the two can never fight.
const draftValue = () => ($data.touched ? $data.draft : ($props.value != null ? String($props.value) : ''))

$watch(
  () => $props.value,
  () => {
    $data.touched = false
  },
)

// Untyped handler param neutralizes to `any`, so reading e.target.value typechecks
// ×6 (the global-filter idiom). Never inline `$data.x = $event.target.value`.
const onInput = (e) => {
  $data.draft = e && e.target ? e.target.value : ''
  $data.touched = true
}

// setFilter is a Function prop (default null) — guard before calling.
const applyFilter = () => {
  $props.setFilter && $props.setFilter($props.columnId, draftValue())
}
const clearFilter = () => {
  $data.draft = ''
  $data.touched = false
  $props.setFilter && $props.setFilter($props.columnId, '')
}

const onKeydown = (e) => {
  if (e && e.key === 'Enter') {
    e.preventDefault()
    applyFilter()
  } else if (e && e.key === 'Escape') {
    e.preventDefault()
    clearFilter()
  }
}

const onBlur = () => {
  applyFilter()
}

// C-11 — the accessible name must be the column's HUMAN header, not its internal id.
// `columnId` is a lookup key (`unit_price`, `col_3`); a screen reader announcing it is
// reading an implementation detail aloud. table-core keeps the authored header on
// `column.columnDef.header`, which is a string for every declarative `<Column header>`;
// a header rendered by a function has no static text, so fall back to the id rather
// than invent one.
const a11yLabel = () => {
  if (typeof $props.columnLabel === 'string' && $props.columnLabel !== '') return $props.columnLabel
  return $props.columnId
}
</script>

<template>
<input
  class="rdt-col-filter"
  part="col-filter"
  type="text"
  :aria-label="a11yLabel()"
  :value="draftValue()"
  @input="onInput($event)"
  @keydown="onKeydown($event)"
  @blur="onBlur()"
/>
</template>

</rozie>
