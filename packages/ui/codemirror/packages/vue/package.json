{
  "name": "@rozie-ui/codemirror-vue",
  "version": "0.1.4",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "Idiomatic Vue code editor — one Rozie source compiled to Vue wrapping CodeMirror 6.",
  "keywords": [
    "rozie",
    "rozie-ui",
    "codemirror",
    "editor",
    "code-editor",
    "component",
    "vue"
  ],
  "author": "One Learning Community (https://github.com/One-Learning-Community)",
  "homepage": "https://github.com/One-Learning-Community/rozie.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/One-Learning-Community/rozie.js.git",
    "directory": "packages/ui/codemirror/packages/vue"
  },
  "bugs": {
    "url": "https://github.com/One-Learning-Community/rozie.js/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./source": {
      "vue": "./src/CodeMirror.vue",
      "default": "./src/CodeMirror.vue"
    },
    "./languages": {
      "types": "./src/languages.ts",
      "import": "./src/languages.ts",
      "default": "./src/languages.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "web-types.json"
  ],
  "peerDependencies": {
    "vue": "^3.4",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-sass": "^6",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/theme-one-dark": "^6",
    "codemirror": "^6"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    },
    "@codemirror/state": {
      "optional": false
    },
    "@codemirror/view": {
      "optional": false
    },
    "@codemirror/commands": {
      "optional": false
    },
    "@codemirror/lang-javascript": {
      "optional": false
    },
    "@codemirror/theme-one-dark": {
      "optional": false
    },
    "codemirror": {
      "optional": false
    },
    "@codemirror/lang-html": {
      "optional": true
    },
    "@codemirror/lang-css": {
      "optional": true
    },
    "@codemirror/lang-sass": {
      "optional": true
    },
    "@codemirror/lang-vue": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/lang-yaml": {
      "optional": true
    },
    "@codemirror/lang-xml": {
      "optional": true
    },
    "@codemirror/lang-python": {
      "optional": true
    },
    "@codemirror/lang-sql": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "codemirror": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-sass": "^6",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@vitejs/plugin-vue": "^6",
    "vite": "^8",
    "vite-plugin-css-injected-by-js": "^5",
    "vue": "^3.5",
    "vue-tsc": "^3"
  },
  "web-types": "./web-types.json"
}
