<!--
  Select.rozie — a headless, WAI-ARIA select-only Select (APG select-only combobox).

  The first @rozie-ui family with NO third-party vanilla engine: every line of
  behaviour — roving virtual focus (aria-activedescendant), full keyboard
  navigation, type-ahead, single + multi select — is authored in Rozie itself.
  (Type-to-filter is owned by the sibling @rozie-ui/combobox family — P3/D-03
  retired Select's editable-input mode; both families share the
  @rozie-ui/headless-core/listCore.rzts spine.) It exists to stress the *native*
  author-side primitives the engine-wrapper families never exercise on their own:

    - $computed-derived state          → the filtered + active-resolved option list
    - parameterized @keydown modifiers → arrow/home/end/enter/escape navigation
    - $refs-driven focus management     → input/listbox/option focus, read post-mount only
    - two-way r-model:value            → selection is a controlled form value (Angular CVA)
    - scoped slots                     → #option / #selected / #empty render props
    - $expose imperative handle        → open / close / toggle / clear / focusControl

  It follows the ARIA APG "Select-Only Combobox" pattern (the trigger keeps
  role="combobox"): DOM focus stays on the control, the highlighted option is
  tracked virtually via `aria-activedescendant`, and selection commits a fresh value.

  Authoring notes (collision classes a no-engine component is the first to hit):
    - `$data.open` collides with the `open` $expose verb — Phase 46 ITEM-5 now
      auto-renames the INTERNAL state to `open$local` (cross-target; the exposed
      `open()` verb stays). This file dogfoods that fix by using the natural
      `$data.open` instead of the old `$data.expanded` workaround.
    - A local helper named `valueOf` (an Object.prototype member) collides with
      the inherited member when it becomes a Lit/Angular class field — Phase 46
      ITEM-5 now auto-renames it to `valueOf$local`. This file dogfoods that fix
      by using the natural `valueOf` instead of the old `valueOf` workaround.
    - The focus verb is `focusControl`, not `focus` — a `focus` $expose verb is a
      DELIBERATE override of the inherited HTMLElement.focus on the Lit custom
      element (ROZ137 warns, does not auto-rename — the public handle is intended).
    - `open`/`close`/`toggle` (and `select`/`clear`) each `$emit` directly in
      `listCore.rzts` — Phase 73 item #8 removed the old "route every emit
      through ONE wrapper fn" workaround after verifying against the current
      emitter that the shipped Phase 46 ITEM-1 hoist-once dedupe already
      collapses N escaping helpers sharing an emit target into a single
      `const {onX}=props` destructure (no TS2451), regardless of how many
      functions call `$emit` for the same event.

  Consumer example (select-only):

    <Select r-model:value="$data.fruit" :options="$data.fruits" placeholder="Pick a fruit…">
      <template #option="{ option, active, selected }">
        <span :class="{ active, selected }">{{ option.label }}</span>
      </template>
    </Select>
-->

<rozie name="Select" vendorable="true">

<types>
/** An entry of the `groups` prop. */
export interface SelectGroup { id: string; label: string }
</types>

<!--
  The popup floats through the composed @rozie-ui/popover leaf (Floating UI) —
  the same published-leaf composition Combobox and data-table use. The stable
  package-style specifier resolves, via @rozie/core's resolveManifestProducer, to
  the PUBLISHED per-target `@rozie-ui/popover-<target>` package's compiled
  manifest at compile time; that package is a runtime peerDependency of each
  select leaf and is not re-exported. Do NOT hand-write a relative
  `./Popover.rozie`.
-->
<components>{ Popover: '@rozie-ui/popover/Popover.rozie' }</components>

<props>
{
  // The option set. Each entry is either a primitive (string/number) or an
  // object; objects resolve their label/value/disabled via the option* props
  // (falling back to `.label` / `.value` / `.disabled`).
  options:        {
    type: Array,
    default: () => [],
    docs: {
      description:
        'The option set. Each entry is either a primitive (`string`/`number`) or an object; objects resolve their label, value, and disabled state via the `option*` resolver props, falling back to `.label` / `.value` / `.disabled`.',
    },
  },

  // The selected value (two-way). Scalar in single-select; an array of values
  // in multi-select. As the sole `model:true` prop it drives the Angular CVA —
  // a Select IS a form control.
  value:          {
    type: null,
    default: null,
    model: true,
    docs: {
      description:
        'The selected value (two-way `r-model`) — a scalar in single-select, an array of values in multi-select. As the sole `model: true` prop it drives the Angular `ControlValueAccessor`, so a Select **is** a form control (`[(ngModel)]` / `[formControl]` bind directly).',
      example: '<Select r-model:value="fruit" :options="fruits" />',
    },
  },

  // Multi-select: `value` becomes an array; selecting toggles membership and
  // keeps the popup open.
  multiple:       {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Enable multi-select: `value` becomes an array, selecting an option toggles its membership, and the popup stays open after each commit.',
    },
  },

  // Render the results list IN FLOW (static) instead of as a floating popup.
  // Use when the select is embedded inside a fixed-size, overflow-clipped
  // container (e.g. a command-palette panel) where a floating popup would be
  // culled. Off (default) keeps the standalone dropdown behavior. Forwards
  // `disablePositioning` + `disableDismiss` to the composed popover.
  inline:         {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Render the results list in normal flow (static) rather than as an absolutely-positioned popup. Use when embedding the select inside an `overflow:hidden` container (e.g. a command palette) so the list is not clipped. Defaults `false` (standalone dropdown behavior).',
    },
  },

  disabled:       {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Disable the control entirely. Also sets the Angular `ControlValueAccessor` disabled state.',
    },
  },
  placeholder:    {
    type: String,
    default: '',
    docs: {
      description: 'Placeholder text shown in the empty control.',
    },
  },

  // Close the popup after a selection. Defaults true; multi-select callers
  // usually want it open — pass :closeOnSelect="false".
  closeOnSelect:  {
    type: Boolean,
    default: true,
    docs: {
      description:
        'Close the popup after a single-select commit. Defaults `true`; multi-select keeps the popup open regardless of this setting.',
    },
  },

  // Resolver overrides for object options.
  optionLabel:    {
    type: Function,
    default: null,
    docs: {
      description:
        "Resolver override for an object option's display label — `(option) => string`. Falls back to the option's `.label` property.",
    },
  },
  optionValue:    {
    type: Function,
    default: null,
    docs: {
      description:
        "Resolver override for an object option's committed value — `(option) => value`. Falls back to the option's `.value` property.",
    },
  },
  optionDisabled: {
    type: Function,
    default: null,
    docs: {
      description:
        'Resolver override marking an option non-selectable — `(option) => boolean`. Falls back to the option\'s `.disabled` property.',
    },
  },

  // Stable id base for the ARIA wiring (popup id + per-option ids +
  // aria-activedescendant). '' (the default) -> a unique per-instance base
  // generated in $onMount (idRoot()), so instances never share ids.
  idBase: {
    type: String,
    default: '',
    docs: {
      description:
        'Id base for the popup, option and control elements — `aria-activedescendant` needs real ids. Option ids are `idBase + "-opt-" + i`, the popup id is `idBase + "-list"`. Leave it empty (the default) and each instance generates a unique id base after mount (`rozie-select-<n>`). Named `idBase` (not `id`) to avoid shadowing `HTMLElement.id` on the Lit custom element.',
    },
  },

  hideEmpty: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Show nothing instead of the empty state: when there are no options the popup is not shown, the control reports `aria-expanded="false"`, and Escape is left to the host.',
    },
  },
  selectOnTab: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Tab picks the highlighted option while the popup is open and an option is highlighted, then moves focus normally. Default `false` (Tab only closes the popup).',
    },
  },

  // ── Floating positioning via the composed @rozie-ui/popover leaf ──────────
  // Forwarded straight through to the single Popover wrapper around the control
  // and both list branches. Ignored when `inline` is set — `inline` forwards
  // `disablePositioning` to popover instead, so the popup never floats.
  placement: {
    type: String,
    default: 'bottom-start',
    docs: {
      description:
        'Floating UI placement of the popup relative to the control, forwarded to the composed `@rozie-ui/popover` leaf — one of `top`/`right`/`bottom`/`left`, each optionally suffixed `-start`/`-end`. Default `"bottom-start"` keeps the popup flush with the control\'s left edge. Ignored when `inline` is set.',
    },
  },
  offset: {
    type: Number,
    default: 4,
    docs: {
      description:
        'Gap in pixels between the control and the popup, forwarded to the composed `@rozie-ui/popover` leaf. Default `4`. Ignored when `inline` is set (the in-flow gap is the `--rozie-select-popup-offset` token).',
    },
  },
  disableFlip: {
    type: Boolean,
    default: false,
    docs: {
      description:
        "Disable the popup's Floating UI `flip` middleware (forwarded to the composed `@rozie-ui/popover` leaf). By default the popup flips above the control when it would overflow the viewport below; set this to keep it pinned to `placement` regardless. Ignored when `inline` is set.",
    },
  },
  disableShift: {
    type: Boolean,
    default: false,
    docs: {
      description:
        "Disable the popup's Floating UI `shift` middleware (forwarded to the composed `@rozie-ui/popover` leaf). By default the popup shifts to stay within the viewport; set this to keep it strictly aligned to the control. Ignored when `inline` is set.",
    },
  },

  // Fill the container: root display:block + width:100%; the control stretches
  // via a `cqw` width against the root (the anchor wrapper is popover-owned +
  // shrink-to-fit, so a plain percentage would be circular), and the
  // width-matched popup follows.
  block: {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Fill the container: the root becomes `display: block; width: 100%`, the control stretches to that width, and the width-matched popup follows. Adds the `rozie-select--block` modifier class on the root. Default `false` keeps the content-sized control (at least `--rozie-select-min-width`).',
    },
  },

  // Option groups: an ordered `[{ id, label }]` section list. Options carry an
  // optional `group` id; the list renders one `role="group"` block per section
  // and keyboard navigation follows that visual order. Off while `virtual` is on.
  groups: {
    type: Array,
    default: () => [],
    docs: {
      description:
        'Ordered section list `[{ id, label }]` setting group order and heading text. Options are partitioned by their optional `group` string; groups present on options but absent here follow in first-appearance order. Empty (the default) renders a flat list. Ignored when `virtual` is on.',
    },
  },

  // Accessible name for the control when there is no visible <label for>.
  ariaLabel:      {
    type: String,
    default: null,
    docs: {
      description:
        'Accessible name for the control when there is no visible `<label for>` pointing at its `id` (`aria-label`).',
    },
  },

  // ── Vertical option windowing (Phase 64 P4, SC-5) ──────────────────────
  // Opt-in long-list windowing. When `true`, only the visible slice of options
  // renders inside the bounded, scrolling list (with leading/trailing spacer
  // rows preserving total scroll height), windowing over the FILTERED option set
  // via the shared @rozie-ui/headless-core/windowing.rzts math (the same
  // virtual-core bridge data-table uses, wired here per-consumer with a no-op pin
  // hook). Default `false` is byte-identical to a non-windowed select.
  virtual:        {
    type: Boolean,
    default: false,
    docs: {
      description:
        'Opt-in vertical **option windowing** for long lists. When `true`, only the visible slice of options renders inside a bounded scrolling list (leading/trailing spacers preserve the total scroll height), windowing over the filtered option set. Default `false` is byte-identical to a non-windowed select. Pair with `inline` + `maxHeight` so the windowed scroll container is bounded. Grouping is not applied while `virtual` is on.',
    },
  },

  // Estimated option row height (px) seeding the windowing engine before
  // measureElement refines actual heights. Only consulted when `virtual` is on.
  estimateRowHeight: {
    type: Number,
    default: 36,
    docs: {
      description:
        'Estimated option row height (px) seeding the windowing engine before `measureElement` refines actual heights. Only consulted when `virtual` is on.',
    },
  },

  // A CSS length string bounding the list scroll container when `virtual` is on
  // (e.g. '320px'). Mirrored to the --rozie-select-max-height token.
  maxHeight:      {
    type: String,
    default: '',
    docs: {
      description:
        "A CSS length string bounding the list scroll container when `virtual` is on (e.g. `'320px'`). Mirrored to the `--rozie-select-max-height` custom property; the prop wins, the token is the fallback. Ignored when `virtual` is off.",
    },
  },
}
</props>

<data>
{
  // The generated id base (idRoot()), set once in $onMount when `idBase` is empty.
  autoId: '',
  open: false,
  // The composed popover's `open` model. The popover is shown exactly while the
  // popup is visible (popupVisible()); it writes `false` here itself when it
  // dismisses (outside click / document-level Escape). See syncPanel() below.
  panelOpen: false,
  // The last value THIS component wrote to `panelOpen`. A `panelOpen` that differs
  // from it was written by the popover.
  panelEcho: false,
  // Virtual focus: index into the visible option list, or -1.
  activeIndex: -1,
  // Kept at '' for select-only: the `#empty` slot exposes it and the spine's
  // `clear()` resets it. No <input> writes it now that the editable-input mode
  // is retired (P3/D-03).
  query: '',
  // ── Windowing host state (Phase 64 P4) — the windowing.rzts host contract ──
  // `rows` is the indexable full model the windowing math maps the slice over
  // (kept === windowSource() / visibleOptions()); windowVer/editVer are the
  // window/edit version reactivity bumps (editVer is inert here — the no-op pin
  // hook never bumps it — but the shared math reads it, so it must exist).
  rows: [],
  windowVer: 0,
  editVer: 0,
}
</data>

<script>
// Type-ahead buffer for the select-only trigger. Module-scope
// `let`s reassigned from handlers → the React emitter hoists them to `useRef`
// so they persist across renders (the setup-once guarantee); no-op elsewhere.
// They STAY in this host (not the shared spine) per the A==B rule: reassigned
// module-`let`s + sigils live in the host; the partial only closes over them.
let typeBuffer = ''
let typeTimer = null

// ---- shared list spine (P2: @rozie-ui/headless-core/listCore.rzts) ------
// The option resolvers, single+multi selection, close/clear, and the
// activeDescendant derivation come from the shared list spine. It is a
// compile-time `.rzts` script-partial: it dissolves into this leaf via
// inlineScriptPartials() before IR lowering (zero runtime dep). The spine closes
// over this host's pieces by convention: idRoot() and the impure ref fn
// focusControl (below). Navigation, type-ahead and open/toggle are host-local —
// see HOST-LOCAL NAVIGATION below; they use the reassigned module-`let`s
// typeBuffer/typeTimer (above) and scrollActiveIntoView (below).
import { labelOf, valueOf, disabledOf, optionId, selectedLabel, activeDescendant, isSelected, close, select, clear, onOptionPointerMove } from '@rozie-ui/headless-core/listCore.rzts'

// ---- option grouping (src/internal/groupOptions.ts) ---------------------
// The pure stable-partition helper is a RUNTIME import (not a `.rzts` partial):
// codegen's `copyInternal` vendors it into each leaf at `./internal/groupOptions`.
// It is a byte copy of @rozie-ui/headless-core/src/internal/groupOptions.ts.
import { groupOptions } from './internal/groupOptions'

const groupOfOption = (opt) => (opt !== null && typeof opt === 'object' && 'group' in opt ? opt.group : null)
// Grouping is active only for a non-empty `groups` list, and never while windowing.
const isGrouped = () => !$props.virtual && Array.isArray($props.groups) && $props.groups.length > 0
// Visual order: identity when ungrouped, group-partitioned when grouped. Memoised on
// the inputs so repeated calls in one render return the SAME array (stable indices).
const orderedOptions = $memo(
  () => (isGrouped() ? groupOptions($props.options, $props.groups, groupOfOption).ordered : $props.options),
  () => [$props.options, $props.groups, $props.virtual],
)
// Blocks for the grouped render; each item carries its index in visibleOptions().
const groupBlocks = () => {
  const res = groupOptions($props.options, $props.groups, groupOfOption)
  let i = 0
  return res.blocks.map((b) => ({ group: b.group, items: b.items.map((opt) => ({ opt, index: i++ })) }))
}

// ══ HOST-LOCAL NAVIGATION (begin) ═════════════════════════════════════════
// These ten functions are defined here instead of imported from listCore.rzts.
// The spine's navigation is bound to the spine's own `visibleOptions()`, and the
// partial inliner does not allow shadowing one function of a partial (ROZ139).
// Select needs navigation over the grouped VISUAL order, so it owns
// `visibleOptions` and every spine function that reaches it. The nine below
// `visibleOptions` are VERBATIM copies of listCore.rzts, kept in sync by
// tests/spine-copies.test.ts — change them in the spine first, then here.
// Combobox likewise keeps its navigation host-local.

// The option list every index refers to, in visual order. Select-only: there is
// no query filter (nothing writes `$data.query`).
const visibleOptions = () => orderedOptions()

const resolveInitialActive = () => {
  const opts = visibleOptions()
  const sel = opts.findIndex((o) => isSelected(o) && !disabledOf(o))
  if (sel !== -1) return sel
  return opts.findIndex((o) => !disabledOf(o))
}

const open = () => {
  if ($props.disabled) return
  if ($data.open) return
  $data.open = true
  $data.activeIndex = resolveInitialActive()
  $emit('open-change', { open: true })
}

const toggle = () => {
  if ($data.open) close()
  else open()
}

const nextEnabled = (from, dir) => {
  const opts = visibleOptions()
  if (opts.length === 0) return -1
  let i = from
  for (let step = 0; step < opts.length; step++) {
    i += dir
    if (i < 0) i = opts.length - 1
    else if (i >= opts.length) i = 0
    if (!disabledOf(opts[i])) return i
  }
  return from
}

const move = (dir) => {
  if (!$data.open) { open(); return }
  const start = $data.activeIndex < 0 ? (dir > 0 ? -1 : 0) : $data.activeIndex
  $data.activeIndex = nextEnabled(start, dir)
  scrollActiveIntoView()
}

const moveEdge = (toEnd) => {
  if (!$data.open) open()
  $data.activeIndex = toEnd ? nextEnabled(-1, -1) : nextEnabled(-1, 1)
  scrollActiveIntoView()
}

const commitActive = () => {
  const opts = visibleOptions()
  if ($data.activeIndex >= 0 && $data.activeIndex < opts.length) select(opts[$data.activeIndex])
}

const onTypeahead = (ch) => {
  if (typeTimer !== null) clearTimeout(typeTimer)
  typeBuffer += ch.toLowerCase()
  typeTimer = setTimeout(() => { typeBuffer = '' }, 600)
  const opts = visibleOptions()
  const idx = opts.findIndex((o) => !disabledOf(o) && labelOf(o).toLowerCase().startsWith(typeBuffer))
  if (idx !== -1) {
    if (!$data.open) open()
    $data.activeIndex = idx
    scrollActiveIntoView()
  }
}

const onControlKeyDown = ($event) => {
  const key = $event.key
  if (key === 'ArrowDown') { $event.preventDefault(); move(1) }
  else if (key === 'ArrowUp') { $event.preventDefault(); move(-1) }
  else if (key === 'Home') { $event.preventDefault(); moveEdge(false) }
  else if (key === 'End') { $event.preventDefault(); moveEdge(true) }
  else if (key === 'Enter') { if ($data.open) { $event.preventDefault(); commitActive() } }
  else if (key === 'Escape') { if ($data.open) { $event.preventDefault(); close(); focusControl() } }
  else if (key === ' ' || key === 'Spacebar') {
    // Space toggles / commits in a select-only host (a button trigger). A
    // filter-input host types the literal space into its <input> and does NOT
    // route Space through this reducer, so this branch is select-only by use.
    $event.preventDefault()
    if (!$data.open) open()
    else commitActive()
  }
  else if (key === 'Tab') { if ($data.open) close() }
  else if (key.length === 1 && !$event.metaKey && !$event.ctrlKey && !$event.altKey) {
    onTypeahead(key)
  }
}
// ══ HOST-LOCAL NAVIGATION (end) ═══════════════════════════════════════════

// ---- shared windowing math (Phase 64 P4: @rozie-ui/headless-core/windowing.rzts) ----
// The PURE windowing math (the windowed slice + spacer geometry) is the SAME
// virtual-core bridge data-table consumes. It is a compile-time `.rzts` partial:
// the imported symbols DISSOLVE into this leaf via inlineScriptPartials() before
// IR lowering (zero runtime dep). The math closes over this host's pieces BY
// CONVENTION (D-04/D-05): windowSource(), the virtualizer instance + gridScrollEl +
// the virtual-core fns, scheduleRemeasure(), $data.windowVer/$data.editVer, and the
// no-op pin hook pinnedEditIndex()/pinnedMeasurement() defined below. The impure
// DOM/refs pieces stay HERE per-consumer (ROZ123). NB the pin hooks are defined in
// THIS host (not the shared partial) so data-table's A==B byte-identity is untouched.
import { virtualItemKey, virtualizerOptions, windowedRows, padTop, padBottom, pmIndexInWindow, rowIsOutsideWindow } from '@rozie-ui/headless-core/windowing.rzts'

// virtual-core: the framework-agnostic windowing state machine (the data-table
// precedent — NO per-framework adapter). The static import is emitted unconditionally
// (a peer dep); every RUNTIME reference sits behind `if ($props.virtual)` / a
// `virtualizer` guard so the non-virtual emitted path executes none of it
// (byte-identical-off).
import { Virtualizer, elementScroll, observeElementRect, observeElementOffset, measureElement } from '@tanstack/virtual-core'

// Windowing instance state (the `let table` precedent — React hoists reassigned
// module-`let`s to useRef; do NOT const). NULL until $onMount, and ONLY constructed
// when $props.virtual. gridScrollEl is the captured .rozie-select-list scroll div the
// virtualizer observes; remeasurePending dedupes the deferred sweep.
let virtualizer = null
let virtualizerCleanup = null
let gridScrollEl = null
let remeasurePending = false
// Scroll-end pin state (see recordScrollEnd()): whether the USER left the view at the end,
// the option count at that moment, and the last scrollTop already accounted for.
let scrollEndPinned = false
let scrollEndPinnedCount = -1
let scrollEndPinnedTop = -1

// windowSource(): the windowing.rzts host-contract row source — the FILTERED option
// set. CR-02: the shared windowing contract requires each row to carry a STABLE `.id`
// (windowing.rzts virtualItemKey reads src[i].id, and the windowed template keys on
// wr.row.id). A raw Select option is a primitive or a bare { label, value, disabled }
// — NOT guaranteed to have `.id` — so an unwrapped raw set keyed on wr.row.id collapses
// every framework :key (and every virtual-core measurement key) to `undefined`, which
// recycles the wrong DOM node as the window scrolls. Wrap each option into an id-bearing
// row the way the sibling Combobox's filteredOptions() does — `id` is the resolved
// value, `_opt` the original option (read via wr.row._opt in the windowed template),
// `_i` the source index. Kept === $data.rows so the math's rowList[vi.index] resolves to
// the same wrapped row the count windows over.
//
// $memo, keyed on the TRUE inputs. The key covers everything the map reads:
// options ref + groups + virtual (visibleOptions' inputs — with `virtual` on,
// grouping is off, so this is source order) and the optionValue resolver
// (valueOf in the map body).
// Same reference-stability contract the sibling Combobox's filteredOptions carries —
// virtual-core's getItemKey/getMeasurements walk this O(count) per pass, so an
// unmemoized per-call re-map made every scroll tick O(N²) in wrapper allocations.
const windowSource = $memo(
  () => visibleOptions().map((o, i) => ({ id: valueOf(o), _opt: o, _i: i })),
  () => [$props.options, $props.groups, $props.virtual, $props.optionValue],
)

// D-05 NO-OP PIN HOOK (defined in THIS host, NOT the shared partial — keeps data-table
// A==B intact). The shared windowedRows/padTop/padBottom call pinnedEditIndex()/
// pinnedMeasurement() UNGUARDED by convention; a select has no edit-pinning, so these
// reduce the pin union (-1 → never unioned) and the spacer subtraction (null → identity)
// to a no-op. They MUST exist or the by-convention call ReferenceErrors at mount.
const pinnedEditIndex = () => -1
const pinnedMeasurement = (pin) => null

// D-05 windowing.rzts host-contract one-liner (Phase 87 87-02). rowsWindowed() preserves
// today's EXACT truthiness (byte-behavior-identical) — it is the REQUIRED symbol
// windowing.rzts calls in place of a bare `$props.virtual` read. NOT type-annotated — this
// `<script>` block has no `lang="ts"` (unlike windowing.rzts / Combobox.rozie), so the
// pinMeasurement() explicit-return-type trick (windowing.rzts:65-74) does not apply here; nothing
// in this plan calls these through a type-narrowing wrapper.
//
// GAP-CLOSURE 87-16 (WR-02): the column-axis host-contract symbols (`colVirtualizer`,
// `colsWindowed()`, `columnCount()`, `columnSize()`, `forcedColumns()`) that 87-02 added
// alongside this were REMOVED here — they were dead code shipped on a mistaken premise
// about the compiler's tree-shaking BFS. Select imports only `{ virtualItemKey,
// virtualizerOptions, windowedRows, padTop, padBottom, pmIndexInWindow, rowIsOutsideWindow }`
// from windowing.rzts; none of those functions' bodies reference the column-axis symbols
// (only `columnVirtualizerOptions()`/`windowedColIndices()`/`colPadLeft()`/`colPadRight()`/
// `colIsOutsideWindow()` do, and Select never imports any of those), so
// `inlineScriptPartials()`'s BFS never needed them to exist. See 87-REVIEW.md WR-02 /
// 87-16-SUMMARY.md for the verification trail.
const rowsWindowed = () => !!$props.virtual
// autoMeasureOn() (Phase 87 87-07, D-18/D-20): the content-driven-estimate host-contract
// gate. Select never lights this branch — a permanent `false` keeps windowing.rzts's
// estimateRowSize()/refineRowEstimate() accumulator dead code here. RETAINED (unlike the
// column-axis symbols above): `virtualizerOptions()` — which Select DOES import and call
// — wires `estimateSize: (i) => estimateRowSize(i)`, and `estimateRowSize()` calls
// `autoMeasureOn()` as its first line. This one IS reachable through the import graph.
const autoMeasureOn = () => false

// Keep $data.rows === windowSource() so the windowing math indexes the live option set.
const syncRows = () => { $data.rows = windowSource() }

// SCROLL-END PIN (the data-table D-19 twin): keep a user who scrolled to the END of a
// variable-height list at the end while the options in view measure taller than their
// estimate. The view is judged on the DOM, and only at a move the USER made — a move is
// virtual-core's own when it still holds an unreconciled scroll adjustment
// (scrollAdjustments !== 0): its above-viewport compensation writes an ABSOLUTE scrollTop
// computed from its last-observed (stale) offset, so it pulls the view back up from the end
// and must neither clear the pin nor be mistaken for the user leaving the end. That position
// is remembered so the scroll event that later reports it is not read as a user move either.
// (Judging on virtual-core's MODEL, as the data-table host does, fails here: its total grows
// with every option measured in the ResizeObserver batch while its offset stays at the stale
// value, so the pin was cleared mid-batch — every target ended 10-126px short, measured.)
const recordScrollEnd = () => {
  if (!virtualizer || !gridScrollEl || virtualizer.scrollState) return
  const top = gridScrollEl.scrollTop
  if (top === scrollEndPinnedTop) return
  scrollEndPinnedTop = top
  if (virtualizer.scrollAdjustments !== 0) return
  // Only a list that actually overflows has an end to hold: while the window has not painted
  // yet (or the list is closed), scrollHeight <= clientHeight reads as "at the end" and a pin
  // recorded then would jump the freshly opened list to the bottom.
  const sh = gridScrollEl.scrollHeight
  const ch = gridScrollEl.clientHeight
  scrollEndPinned = ch > 0 && sh - ch > 1 && sh - top - ch <= 1
  scrollEndPinnedCount = windowSource().length
}

// Re-apply the pin after the framework has committed the window (called from the rAF pass):
// the real maximum is known only then. Not while a programmatic scroll (scrollToIndex) is in
// flight, and not when the option count changed since the user reached the end (a new filter
// or appended options must not be auto-followed).
const keepScrollEnd = () => {
  if (!scrollEndPinned || !virtualizer || !gridScrollEl || virtualizer.scrollState) return
  if (windowSource().length !== scrollEndPinnedCount) return
  const maxTop = gridScrollEl.scrollHeight - gridScrollEl.clientHeight
  if (maxTop - gridScrollEl.scrollTop > 1) {
    gridScrollEl.scrollTop = maxTop
    scrollEndPinnedTop = gridScrollEl.scrollTop
  }
}

// Defer remeasureWindow() until AFTER the framework commits the recycled window
// (onChange fires BEFORE React/Solid commit). TWO deferred passes (microtask THEN rAF)
// behind one in-flight flag (the data-table virtualization.rzts:46-56 pattern, copied
// per-consumer per D-04/D-09): the microtask catches Solid's <For> / Svelte's {#each}
// SYNCHRONOUS commit (the Phase 63 Solid under-convergence hazard — D-09 rAF-defer
// budget), the rAF catches React's async commit. measureElement is idempotent on an
// already-observed node, so running both is cheap and loop-free.
const scheduleRemeasure = () => {
  recordScrollEnd()
  if (remeasurePending) return
  remeasurePending = true
  let ranMicro = false
  const microPass = () => { remeasureWindow() }
  // N-05 (quick 260923-rrr): key the rAF pass on the OUTCOME. React and Angular commit the
  // recycled window AFTER the first rAF, so one pass measured the OLD options and the new ones
  // waited for virtual-core's 150ms scrolling-ended tick — with variable-height options the late
  // above-viewport adjustment then moved the whole list (measured). Re-run next frame until the
  // committed options cover the virtualizer's window, bounded (the data-table host twin).
  let rafAttempts = 0
  const rafPass = () => {
    const covered = remeasureWindow()
    rafAttempts = rafAttempts + 1
    if (!covered && rafAttempts < 10 && typeof requestAnimationFrame === 'function') {
      requestAnimationFrame(rafPass)
      return
    }
    keepScrollEnd()
    remeasurePending = false
  }
  if (typeof queueMicrotask !== 'undefined') { ranMicro = true; queueMicrotask(microPass) }
  if (typeof requestAnimationFrame === 'function') requestAnimationFrame(rafPass)
  else if (ranMicro) remeasurePending = false
  else setTimeout(rafPass, 0)
}

// measureElement sweep: hand every rendered windowed option to the virtualizer so its
// true (variable) height is observed (virtual-core measures ONLY nodes passed to
// measureElement, keyed by the data-index attribute). Bails during a programmatic
// scroll (scrollToIndex) so a measure can't starve the scroll target.
const remeasureWindow = () => {
  if (!virtualizer || !gridScrollEl) return true
  if (virtualizer.scrollState) return true
  const els = gridScrollEl.querySelectorAll('.rozie-select-option[data-index]')
  const rendered = new Set()
  for (const el of els) {
    virtualizer.measureElement(el)
    rendered.add(el.getAttribute('data-index'))
  }
  // N-05: false while the framework has not yet committed the recycled window.
  const items = virtualizer.getVirtualItems()
  for (let i = 0; i < items.length; i++) {
    if (!rendered.has(String(items[i].index))) return false
  }
  return true
}

// ---- focus / scroll helpers (post-mount $refs only) --------------------
// Impure ($refs) → per the ROZ123 + A==B rules they stay in the host (the spine
// only closes over them). Named `focusControl` (not `focus`): a `focus` $expose
// verb would override the inherited HTMLElement.focus method on the Lit element.
const focusControl = () => {
  $refs.triggerEl?.focus()
}

// Keep the active option visible inside the scrolling listbox. Reads $refs in
// a post-mount callback only (never eagerly — ROZ123). When windowing, route through
// the virtualizer (scrollToIndex) so an active option OUTSIDE the rendered window is
// scrolled into view (the windowed-arrow-nav seam); else the native scrollIntoView.
const scrollActiveIntoView = () => {
  if ($data.activeIndex < 0) return
  if ($props.virtual && virtualizer) {
    // 'center' (not 'auto'): keep the active option well inside the rendered slice as the
    // window scrolls — 'auto' lands it at the viewport edge where the overscan band can
    // leave it just-unrendered for a frame on the fine-grained targets (Solid).
    virtualizer.scrollToIndex($data.activeIndex, { align: 'center' })
    scheduleRemeasure()
    return
  }
  if (!$refs.listEl) return
  const el = $refs.listEl.querySelector('#' + CSS.escape(optionId($data.activeIndex)))
  el?.scrollIntoView({ block: 'nearest' })
}

// ---- windowing lifecycle (post-mount; ONLY when virtual) ----------------
// kickWindow: the cross-target first-paint settle. Re-captures the LIVE scroll element,
// re-feeds the CURRENT option count into the virtualizer, re-attaches its rect observer
// (_willUpdate), and bumps the windowVer signal so the windowed <For>/{#each}/repeat
// re-derives. Retried over a few frames because (a) virtual-core measures the scroll rect
// asynchronously (D-09 Solid rAF-defer — a synchronous kick sees rectH 0 → empty window),
// (b) Solid/Lit recreate the list node between mount and first commit (leaving virtual-core's
// scrollElement stale), and (c) the consumer often seeds options AFTER the select mounts
// (Lit/React), so the count must be re-read once the prop propagates. Stops once the window
// paints (or attempts run out) — idempotent + loop-free.
const kickWindow = (attempts) => {
  if (!virtualizer) return
  gridScrollEl = $el ? $el.querySelector('.rozie-select-list') : gridScrollEl
  // Only re-feed the count from a NON-EMPTY source: on React these rAF closures capture
  // stale (mount-time, empty) props, so feeding here would CLOBBER the $watch's correct
  // count back to 0. The $watch (fresh useEffect props) owns React's count; the kick owns
  // the Solid/Lit scroll-element re-attach + the deferred windowVer re-derive.
  if (windowSource().length > 0) {
    syncRows()
    virtualizer.setOptions(virtualizerOptions())
  }
  virtualizer._willUpdate()
  $data.windowVer = $data.windowVer + 1
  remeasureWindow()
  if (windowedRows().length === 0 && attempts > 0) {
    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(() => kickWindow(attempts - 1))
    else setTimeout(() => kickWindow(attempts - 1), 16)
  }
}

// nextAutoId(): a page-wide counter shared by every Rozie component instance. It
// lives on globalThis (read through Reflect, which type-checks in the plain-JS and
// the TS script alike) so separately bundled copies of a leaf never hand out the
// same id. The same four lines live in Combobox, Select and Popover.
const nextAutoId = () => {
  const n = (Number(Reflect.get(globalThis, '__rozieAutoId')) || 0) + 1
  Reflect.set(globalThis, '__rozieAutoId', n)
  return n
}

// idRoot(): the `idBase` prop, else the per-instance id generated in $onMount, else the
// pre-mount fallback. Also the listCore.rzts host contract (its optionId reads it).
const idRoot = () => $props.idBase || $data.autoId || 'rozie-select'
// popupVisible(): the single gate every list branch and aria-expanded read.
const popupVisible = () => {
  if (!$data.open) return false
  if (!$props.hideEmpty) return true
  return visibleOptions().length > 0
}
// ---- composed popover <-> open state ------------------------------------
// The popover's `open` model is bound to $data.panelOpen, NOT to $data.open: the
// popover emits nothing of its own, it only writes its model when it dismisses
// (outside click, or Escape seen at the document). Binding it to a field of its own
// makes that write visible, so a popover-initiated close is routed through the
// spine's close() like every other close — one `open-change` per real transition and
// the highlight reset.
//
// Telling the popover's write from our own is done with STATE, not a flag:
// $data.panelEcho is written together with every $data.panelOpen write made here, so
// in any one render/flush the pair is consistent — equal means "ours", different
// means "the popover closed itself" (it can never open itself: `trigger="manual"`).
// A plain variable in its place is read live while the reactive values are per-render
// snapshots on React: when a close and a re-open land in one commit, both watchers
// run in one pass and the second one misreads our own write as a dismissal (seen as
// a popup that stayed shut after Enter-then-ArrowDown).
// The echo is written FIRST, for targets whose watchers run synchronously on a write.
const syncPanel = () => {
  const visible = popupVisible()
  if (visible === $data.panelOpen) return
  $data.panelEcho = visible
  $data.panelOpen = visible
}
// select -> popover: follows a derived primitive covering everything popupVisible() reads.
$watch(() => (($data.open ? 'o' : 'c') + ($props.hideEmpty ? 'h' : 's') + ($props.options ? $props.options.length : 0) + '|' + $data.query), () => {
  syncPanel()
})
// popover -> select: the popover's own write (a dismissal) goes through close().
$watch(() => $data.panelOpen, () => {
  if ($data.panelOpen === $data.panelEcho) return
  $data.panelEcho = $data.panelOpen
  if (!$data.panelOpen) close()
})

// Select-local keydown wrapper (kept out of listCore so the shared partial and the sibling
// families' generated output stay untouched).
//  - hideEmpty: when the popup is hidden because the list is empty ($data.open is still true
//    internally; only the rendered/ARIA state is gated), Escape and Enter are left entirely to
//    the host - not preventDefault'ed, not consumed. All other keys still reach listCore.
//  - selectOnTab: Tab commits the highlighted option before listCore closes the popup, only
//    while the popup is actually visible.
const onTriggerKeyDown = ($event) => {
  if ($props.disabled) return
  const hidden = $data.open && !popupVisible()
  if (hidden && ($event.key === 'Escape' || $event.key === 'Enter')) return
  if ($event.key === 'Tab' && $data.open && $props.selectOnTab && popupVisible() && $data.activeIndex >= 0) commitActive()
  onControlKeyDown($event)
}

// A number-typed helper: a literal `0`/`-1` tabindex trips TS2869 on React
// (`?? undefined` on a provably non-null operand) - the data-table cellTabindex precedent.
const triggerTabindex = () => ($props.disabled ? -1 : 0)
// One click handler on the whole control: the arrow, padding and (later) the chip
// row all open the popup; the buttons inside stop propagation themselves.
const onControlClick = ($event) => {
  if ($props.disabled) return
  toggle()
  focusControl()
}

$onMount(() => {
  if (!$props.idBase) $data.autoId = 'rozie-select-' + nextAutoId()
  syncRows()
  if ($props.virtual) {
    // The list renders at mount when virtual, so the .rozie-select-list scroll container
    // exists here. Capture it via $el.querySelector (the data-table gridScrollEl precedent,
    // proven ×6 incl Lit shadow + Solid) — $refs on a conditionally-rendered node is null on
    // Solid/Lit, which leaves the virtualizer with no scroll element.
    gridScrollEl = $el ? $el.querySelector('.rozie-select-list') : null
    virtualizer = new Virtualizer(virtualizerOptions())
    virtualizerCleanup = virtualizer._didMount()
    $data.windowVer = $data.windowVer + 1
    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(() => kickWindow(8))
    else setTimeout(() => kickWindow(8), 0)
  }
})

// Reactive re-feed: when the option set (or the query filter) changes, re-sync the
// indexable rows + push fresh options into the virtualizer and re-pull the window
// (the data-table setOptions+_willUpdate re-feed precedent). Watch a derived primitive
// (length + query), never a freshly-built array (the stale-array Pitfall).
$watch(() => (($props.options ? $props.options.length : 0) + '|' + $data.query), () => {
  syncRows()
  if ($props.virtual && virtualizer) {
    gridScrollEl = $el ? $el.querySelector('.rozie-select-list') : gridScrollEl
    virtualizer.setOptions(virtualizerOptions())
    virtualizer._willUpdate()
    $data.windowVer = $data.windowVer + 1
    scheduleRemeasure()
  }
})

// The list shrank under the highlight: move it to the first enabled option.
// A watcher of its own whose getter reads ONLY props: on Lit a getter that mixes
// props with $data (like the one above) is routed through a signal effect, which
// a plain property change never re-runs; a props-only getter is routed through
// updated(changedProperties) and does re-run.
$watch(() => ($props.options ? $props.options.length : 0), () => {
  if ($data.activeIndex >= visibleOptions().length) $data.activeIndex = visibleOptions().length > 0 ? nextEnabled(-1, 1) : -1
})

$onUnmount(() => {
  if (typeTimer !== null) clearTimeout(typeTimer)
  // Tear down the virtualizer's scroll-element ResizeObserver (no-op when virtual off).
  if (virtualizerCleanup) virtualizerCleanup()
})

// Imperative handle. Shorthand keys (aliased `{ open: fn }` keys are dropped by
// the React emitter) — every function is named exactly as its verb.
$expose({ open, close, toggle, clear, focusControl })
</script>

<!-- The composed popover owns outside-click dismissal while it is shown. This listener
     covers the two states it is not: `inline` (dismissal is switched off on the popover,
     the list is in flow) and an open-but-hidden popup (`hideEmpty` with no options — the
     popover is closed, so nothing else would reset the open state). -->
<listeners>
  <listener :target="document" @click.outside($refs.controlEl,$refs.listEl)="close" r-if="$data.open && ($props.inline || !popupVisible())" />
</listeners>

<template>
<div
  class="rozie-select"
  :class="{ 'rozie-select-open': popupVisible(), 'rozie-select-disabled': $props.disabled, 'rozie-select-inline': $props.inline, 'rozie-select--block': $props.block }"
>
  <!-- Composed popover positioning — ONE Popover wraps the control (its `#anchor`
       fill, so Floating UI measures the control's real box and a click on the control
       is "inside" for the popover's outside-click dismissal) and both list branches
       (its default fill). The mechanics mirror Combobox.rozie's composition:
         - `trigger="manual"`: the select drives the open state; the popover only
           positions and dismisses. `r-model:open` is bound to $data.panelOpen (see
           syncPanel() in the script), which is true exactly while the popup is
           visible — so a `hideEmpty` select with nothing to show renders no panel and
           arms no dismissal listeners.
         - `bare`: no popover chrome; `.rozie-select-list` supplies the surface.
         - `:match-width="true"`: the popup spans the control box (what `left: 0;
           right: 0` on the list used to do).
         - `:keep-mounted="$props.virtual"`: the windowed branch must stay mounted
           while closed (the virtualizer holds its scroll element); the popover hides
           its panel instead of unmounting it. Never on for the non-virtual path.
         - `:disable-positioning` + `:disable-dismiss` under `inline`: the list renders
           in normal flow and the popover neither positions nor dismisses it. -->
  <Popover
    trigger="manual"
    r-model:open="$data.panelOpen"
    bare
    :match-width="true"
    :keep-mounted="$props.virtual"
    :disable-positioning="$props.inline"
    :disable-dismiss="$props.inline"
    :placement="$props.placement"
    :offset="$props.offset"
    :disable-flip="$props.disableFlip"
    :disable-shift="$props.disableShift"
    :id-base="idRoot()"
  >
    <template #anchor>
      <!-- Control: a clickable wrapper around the select-only trigger. The trigger is a focusable
           div (not a button) carrying role="combobox" per the ARIA APG "Select-Only Combobox"
           pattern (DOM focus stays here; the active option is tracked virtually via
           aria-activedescendant). It is a div so clear / chip buttons can nest in the control. -->
      <div
        class="rozie-select-control"
        ref="controlEl"
        @click="onControlClick($event)"
      >
        <div
          ref="triggerEl"
          class="rozie-select-trigger"
          role="combobox"
          aria-haspopup="listbox"
          :tabindex="triggerTabindex()"
          :aria-expanded="!!popupVisible()"
          :aria-controls="idRoot() + '-list'"
          :aria-activedescendant="popupVisible() && $data.activeIndex < visibleOptions().length ? activeDescendant : null"
          :aria-label="$props.ariaLabel"
          :aria-disabled="!!$props.disabled"
          @keydown="onTriggerKeyDown($event)"
        >
          <slot name="selected" :selected="selectedLabel" :value="$props.value">
            <span r-if="selectedLabel" class="rozie-select-selected">{{ selectedLabel }}</span>
            <span r-else class="rozie-select-placeholder">{{ $props.placeholder }}</span>
          </slot>
        </div>
        <span class="rozie-select-arrow" aria-hidden="true">▾</span>
      </div>
    </template>

    <!-- `<template #default>` wraps the three r-if branches deliberately: several bare
         r-if siblings passed as a component's loose default-slot children crash
         @rozie/core's extractSlotFillers. -->
    <template #default>
      <!-- Popup listbox (NON-VIRTUAL). aria-activedescendant on the control points at the
           highlighted option id; DOM focus never leaves the control. Byte-identical to the
           pre-windowing render — the `&& !$props.virtual` only routes virtual usage to the
           windowed branch below; with virtual off this is exactly the prior behavior. -->
      <div
        r-if="popupVisible() && !$props.virtual && !isGrouped()"
        ref="listEl"
        class="rozie-select-list"
        role="listbox"
        :id="idRoot() + '-list'"
        :aria-label="$props.ariaLabel"
        :aria-multiselectable="$props.multiple"
      >
        <div
          r-for="opt, index in visibleOptions()"
          :key="optionId(index)"
          :id="optionId(index)"
          class="rozie-select-option"
          :class="{ 'is-active': $data.activeIndex === index, 'is-selected': isSelected(opt), 'is-disabled': disabledOf(opt) }"
          role="option"
          :aria-selected="!!isSelected(opt)"
          :aria-disabled="!!disabledOf(opt)"
          @click="select(opt)"
          @mousemove="onOptionPointerMove(index)"
        >
          <slot name="option" :option="opt" :index="index" :active="$data.activeIndex === index" :selected="isSelected(opt)" :disabled="disabledOf(opt)">
            {{ labelOf(opt) }}
          </slot>
        </div>

        <div r-if="visibleOptions().length === 0" class="rozie-select-empty" role="presentation">
          <slot name="empty" :query="$data.query">No options</slot>
        </div>
      </div>

      <!-- GROUPED listbox (NON-VIRTUAL) — active only when isGrouped(). The options are
           partitioned into `role="group"` blocks in visual order; `row.index` is the
           option's index in visibleOptions(), the same index navigation walks. The
           leading ungrouped block has no heading and no accessible name. -->
      <div
        r-if="popupVisible() && !$props.virtual && isGrouped()"
        ref="listEl"
        class="rozie-select-list"
        role="listbox"
        :id="idRoot() + '-list'"
        :aria-label="$props.ariaLabel"
        :aria-multiselectable="$props.multiple"
      >
        <div
          r-for="blk in groupBlocks()"
          :key="'grp-' + (blk.group ? blk.group.id : '_ungrouped')"
          class="rozie-select-group"
          role="group"
          :aria-label="blk.group ? blk.group.label : null"
        >
          <div r-if="blk.group" class="rozie-select-group-heading" role="presentation">
            <slot name="groupHeading" :group="blk.group" :param-types="{ group: 'SelectGroup' }">{{ blk.group.label }}</slot>
          </div>
          <div
            r-for="row in blk.items"
            :key="optionId(row.index)"
            :id="optionId(row.index)"
            class="rozie-select-option"
            :class="{ 'is-active': $data.activeIndex === row.index, 'is-selected': isSelected(row.opt), 'is-disabled': disabledOf(row.opt) }"
            role="option"
            :aria-selected="!!isSelected(row.opt)"
            :aria-disabled="!!disabledOf(row.opt)"
            @click="select(row.opt)"
            @mousemove="onOptionPointerMove(row.index)"
          >
            <slot name="option" :option="row.opt" :index="row.index" :active="$data.activeIndex === row.index" :selected="isSelected(row.opt)" :disabled="disabledOf(row.opt)">
              {{ labelOf(row.opt) }}
            </slot>
          </div>
        </div>
        <div r-if="visibleOptions().length === 0" class="rozie-select-empty" role="presentation">
          <slot name="empty" :query="$data.query">No options</slot>
        </div>
      </div>

      <!-- ══ WINDOWED listbox (Phase 64 P4, SC-5) — emitted/active ONLY when $props.virtual ══
           Stays MOUNTED whenever virtual (so the .rozie-select-list scroll container exists at
           mount for the virtualizer — ROZ123-safe) but is HIDDEN via display:none whenever the
           listbox is closed (CR-01): unmounting would drop the virtualizer's scroll element, so
           we hide-not-unmount to keep its scrollTop + measurements while still honoring
           toggle()/Escape/outside-click close semantics (the non-virtual branch is gated on
           $data.open; this branch mirrors that via the :style display toggle). display:none also
           drops the role="listbox" from the a11y tree when collapsed, so :aria-expanded on the
           control stays consistent. Renders a leading spacer, the windowed { vi, row } slice
           keyed on the wrapper id (CR-02: windowSource() wraps each option into an id-bearing
           row), and a trailing spacer; the option's full-model index is wr.vi.index. The
           container is bounded/scrolling via the base .rozie-select-list CSS (max-height from
           the --rozie-select-max-height token, mirrored from the maxHeight prop). -->
      <div
        r-if="$props.virtual"
        ref="listEl"
        class="rozie-select-list rozie-select-list--virtual"
        role="listbox"
        :id="idRoot() + '-list'"
        :aria-label="$props.ariaLabel"
        :aria-multiselectable="$props.multiple"
        :style="(popupVisible() ? '' : 'display:none;') + ($props.maxHeight ? ('height:' + $props.maxHeight + ';max-height:' + $props.maxHeight + ';overflow-y:auto;--rozie-select-max-height:' + $props.maxHeight) : 'overflow-y:auto')"
      >
        <div class="rozie-select-spacer" aria-hidden="true" :style="'height:' + padTop() + 'px'"></div>

        <div
          r-for="wr in windowedRows()"
          :key="wr.row.id"
          :id="optionId(wr.vi.index)"
          :data-index="wr.vi.index"
          class="rozie-select-option"
          :class="{ 'is-active': $data.activeIndex === wr.vi.index, 'is-selected': isSelected(wr.row._opt), 'is-disabled': disabledOf(wr.row._opt) }"
          role="option"
          :aria-selected="!!isSelected(wr.row._opt)"
          :aria-disabled="!!disabledOf(wr.row._opt)"
          @click="select(wr.row._opt)"
          @mousemove="onOptionPointerMove(wr.vi.index)"
        >
          <slot name="option" :option="wr.row._opt" :index="wr.vi.index" :active="$data.activeIndex === wr.vi.index" :selected="isSelected(wr.row._opt)" :disabled="disabledOf(wr.row._opt)">
            {{ labelOf(wr.row._opt) }}
          </slot>
        </div>

        <div class="rozie-select-spacer" aria-hidden="true" :style="'height:' + padBottom() + 'px'"></div>

        <div r-if="windowSource().length === 0" class="rozie-select-empty" role="presentation">
          <slot name="empty" :query="$data.query">No options</slot>
        </div>
      </div>
    </template>
  </Popover>
</div>
</template>

<style>
/*
  Fully token-driven. EVERY value is a `var(--rozie-select-*, <fallback>)`, so
  the component renders with zero configuration yet is completely re-skinnable
  by setting tokens at any ancestor scope (`:root`, `.dark`, a wrapper, or the
  `.rozie-select` element itself). The shipped `themes/*.css` presets do exactly
  that — mapping these tokens onto shadcn/Radix, Material 3, and Bootstrap 5.
  Nested var() fallbacks let one token derive from another (ring ← accent,
  popup-bg ← bg) while staying independently overridable.
*/
.rozie-select {
  position: relative;
  display: inline-block;
  min-width: var(--rozie-select-min-width, var(--rsl-min-width, 12rem));
  font: var(--rozie-select-font, inherit);
  /* The popup's stacking order is the composed popover's now; keep the select's own
     `--rozie-select-z` token steering it (custom properties inherit into the panel). */
  --rozie-popover-z: var(--rozie-select-z, var(--rsl-z, 1000));
}
.rozie-select-control {
  box-sizing: border-box;
  /* NOT `width: 100%`: the control renders inside the popover's anchor wrapper
     (`display: inline-block`, shrink-to-fit), so a percentage width is circular. It
     sizes to its content with the root's own minimum, which is the box the root's
     `inline-block` + `min-width` gave it before. `block` and `inline` stretch it. */
  min-width: var(--rozie-select-min-width, var(--rsl-min-width, 12rem));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rozie-select-gap, var(--rsl-gap, 0.5rem));
  padding: var(--rozie-select-control-padding, var(--rsl-control-padding, 0.5rem 0.75rem));
  font: inherit;
  text-align: left;
  background: var(--rozie-select-bg, var(--rsl-bg, #fff));
  color: var(--rozie-select-fg, var(--rsl-fg, #1a1a1a));
  border: var(--rozie-select-border-width, var(--rsl-border-width, 1px)) solid var(--rozie-select-border, var(--rsl-border, rgba(0, 0, 0, 0.2)));
  border-radius: var(--rozie-select-radius, var(--rsl-radius, 6px));
  cursor: pointer;
}
.rozie-select-control:focus-within {
  outline: var(--rozie-select-ring-width, var(--rsl-ring-width, 2px)) solid var(--rozie-select-ring, var(--rozie-select-accent, var(--rsl-ring, var(--rsl-accent, #0066cc))));
  outline-offset: var(--rozie-select-ring-offset, var(--rsl-ring-offset, 1px));
}
.rozie-select-trigger { flex: 1 1 auto; min-width: 0; min-height: 1.5em; outline: none; background: none; border: 0; padding: 0; text-align: start; }
.rozie-select-disabled .rozie-select-control { cursor: default; }
.rozie-select-disabled { opacity: var(--rozie-select-disabled-opacity, var(--rsl-disabled-opacity, 0.6)); pointer-events: none; }
.rozie-select-placeholder { color: var(--rozie-select-placeholder, var(--rsl-placeholder, rgba(0, 0, 0, 0.45))); }
.rozie-select-arrow {
  font-size: 0.75em;
  color: var(--rozie-select-arrow-color, var(--rsl-arrow-color, currentColor));
  opacity: var(--rozie-select-arrow-opacity, var(--rsl-arrow-opacity, 0.7));
}

/* Both list branches render inside the composed popover's `.rozie-popover-floating`
   (positioned by Floating UI, width-matched to the control), so the list carries no
   position / top / left / right / z-index of its own — only its surface. */
.rozie-select-list {
  margin: 0;
  padding: var(--rozie-select-popup-padding, var(--rsl-popup-padding, 0.25rem));
  max-height: var(--rozie-select-max-height, var(--rsl-max-height, 16rem));
  overflow-y: auto;
  list-style: none;
  background: var(--rozie-select-popup-bg, var(--rozie-select-bg, var(--rsl-popup-bg, var(--rsl-bg, #fff))));
  color: var(--rozie-select-fg, var(--rsl-fg, #1a1a1a));
  border: var(--rozie-select-border-width, var(--rsl-border-width, 1px)) solid var(--rozie-select-popup-border, var(--rozie-select-border, var(--rsl-popup-border, var(--rsl-border, rgba(0, 0, 0, 0.15)))));
  border-radius: var(--rozie-select-popup-radius, var(--rozie-select-radius, var(--rsl-popup-radius, var(--rsl-radius, 6px))));
  box-shadow: var(--rozie-select-shadow, var(--rsl-shadow, 0 6px 24px rgba(0, 0, 0, 0.12)));
}

/* Inline mode: the root fills its container (so the control + list span the full
   width even when a host wrapper — lit custom element / angular host — sits
   between it and a stretching flex parent), and the list renders IN FLOW so an
   overflow-clipped ancestor (e.g. a command-palette panel) can't cull it. */
.rozie-select-inline {
  display: block;
  width: 100%;
}
.rozie-select-inline .rozie-select-list {
  margin-top: var(--rozie-select-popup-offset, var(--rsl-popup-offset, 4px));
  border: none;
  border-radius: 0;
  box-shadow: none;
}
/* Inline: the root stretches to its container and the control fills it. The popover
   does not measure the anchor here (`disablePositioning`), so `100cqw` against the
   root is used for the same reason as `block` below. */
.rozie-select-inline,
.rozie-select--block {
  container-type: inline-size;
}
.rozie-select-inline .rozie-select-control,
.rozie-select--block .rozie-select-control {
  width: 100cqw;
}
/* `block`: fill the container. The control takes the root's width as `100cqw` against
   the root query container — the popover-owned anchor around it is shrink-to-fit, so a
   percentage would be circular. The width-matched popup follows the control. */
.rozie-select--block {
  display: block;
  width: 100%;
}
.rozie-select-option {
  padding: var(--rozie-select-option-padding, var(--rsl-option-padding, 0.4rem 0.6rem));
  border-radius: var(--rozie-select-option-radius, var(--rsl-option-radius, 4px));
  color: var(--rozie-select-option-fg, inherit);
  cursor: pointer;
  user-select: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--rozie-select-gap, var(--rsl-gap, 0.5rem));
}
.rozie-select-option.is-active {
  background: var(--rozie-select-active-bg, var(--rsl-active-bg, rgba(0, 102, 204, 0.12)));
  color: var(--rozie-select-active-fg, var(--rsl-active-fg, inherit));
}
.rozie-select-option.is-selected {
  background: var(--rozie-select-selected-bg, var(--rsl-selected-bg, transparent));
  color: var(--rozie-select-selected-fg, var(--rsl-selected-fg, inherit));
  font-weight: var(--rozie-select-selected-weight, var(--rsl-selected-weight, 600));
}
.rozie-select-option.is-selected::after {
  content: var(--rozie-select-check, var(--rsl-check, '✓'));
  color: var(--rozie-select-check-color, var(--rozie-select-accent, var(--rsl-check-color, var(--rsl-accent, #0066cc))));
}
.rozie-select-option.is-disabled { opacity: var(--rozie-select-disabled-opacity, var(--rsl-disabled-opacity, 0.45)); cursor: not-allowed; }
.rozie-select-group-heading {
  padding: var(--rozie-select-group-heading-padding, var(--rsl-group-heading-padding, 0.25rem 0.6rem));
  font-size: var(--rozie-select-group-heading-size, var(--rsl-group-heading-size, 0.75rem));
  font-weight: var(--rozie-select-group-heading-weight, var(--rsl-group-heading-weight, 600));
  color: var(--rozie-select-group-heading-color, var(--rsl-group-heading-color, rgba(0, 0, 0, 0.55)));
}
.rozie-select-empty { padding: var(--rozie-select-option-padding, var(--rsl-option-padding, 0.5rem 0.6rem)); color: var(--rozie-select-empty-fg, var(--rsl-empty-fg, rgba(0, 0, 0, 0.5))); }
/* Windowing spacer rows (Phase 64 P4): zero-chrome blocks whose inline height keeps the
   total scroll height === virtual-core getTotalSize() (the windowed slice sits between). */
.rozie-select-spacer { margin: 0; padding: 0; border: 0; flex: none; }
/* The windowing engine compensates for options above the viewport changing height itself.
   Browser scroll anchoring moved the view again when the leading spacer changed height, and
   that move was indistinguishable from the user scrolling away from the end (measured: the
   scroll-end pin was cleared at a 38px-short position). */
.rozie-select-list--virtual { overflow-anchor: none; }
</style>

</rozie>
