{
  "name": "@rozie-ui/select-vue",
  "version": "0.1.2",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "Idiomatic Vue headless select (single + multi-select, type-ahead, keyboard nav, groups, floating popup) — one accessible Rozie source compiled to Vue.",
  "keywords": [
    "rozie",
    "rozie-ui",
    "select",
    "combobox",
    "select",
    "dropdown",
    "headless",
    "accessibility",
    "aria",
    "component",
    "vue"
  ],
  "author": "One Learning Community (https://github.com/One-Learning-Community)",
  "homepage": "https://github.com/One-Learning-Community/rozie.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/One-Learning-Community/rozie.js.git",
    "directory": "packages/ui/select/packages/vue"
  },
  "bugs": {
    "url": "https://github.com/One-Learning-Community/rozie.js/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./source": {
      "vue": "./src/Select.vue",
      "default": "./src/Select.vue"
    },
    "./themes/*": "./src/themes/*"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@rozie/runtime-vue": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.4",
    "@tanstack/virtual-core": "^3",
    "@rozie-ui/popover-vue": "^0.2.0 || ^0.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    },
    "@tanstack/virtual-core": {
      "optional": false
    },
    "@rozie-ui/popover-vue": {
      "optional": false
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6",
    "vite": "^8",
    "vite-plugin-css-injected-by-js": "^5",
    "vue": "^3.5",
    "vue-tsc": "^3"
  }
}
