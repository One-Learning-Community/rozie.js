{
  "name": "@rozie/runtime-angular",
  "version": "0.10.3",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "license": "MIT",
  "description": "Runtime helpers shared by Rozie-emitted Angular components: the RozieSlot marker directive for keyed slot fills, display/attr interpolation helpers, the :class value flattener, the $provide/$inject context token registry, the r-bind/$attrs spread attribute applier + host-attribute reader factories, and the RozieListen directive for template @event.capture/.passive/.once.",
  "author": "One Learning Community (https://github.com/One-Learning-Community)",
  "homepage": "https://github.com/One-Learning-Community/rozie.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/One-Learning-Community/rozie.js.git",
    "directory": "packages/runtime/angular"
  },
  "bugs": {
    "url": "https://github.com/One-Learning-Community/rozie.js/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/rozie-runtime-angular.mjs"
    }
  },
  "module": "./dist/fesm2022/rozie-runtime-angular.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "tslib": "^2"
  },
  "peerDependencies": {
    "@angular/core": "^19 || ^20 || ^21"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@angular/compiler": "^19",
    "@angular/compiler-cli": "^19",
    "@angular/core": "^19",
    "happy-dom": "^15.0.0",
    "ng-packagr": "^19",
    "typescript": "~5.6.0"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint src"
  },
  "publishConfig": {
    "access": "public"
  }
}
