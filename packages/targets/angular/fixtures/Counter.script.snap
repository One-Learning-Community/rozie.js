import { Component, ViewEncapsulation, computed, input, output, signal, untracked } from '@angular/core';
import { rozieModel } from '@rozie/runtime-angular';


readonly __rozieModelIn_value = input<number | undefined>(undefined, { alias: 'value' });
valueChange = output<number>();
value = rozieModel<number, import('@angular/core').ModelSignal<number>>(this.__rozieModelIn_value, this.valueChange, 0, { signal, computed, untracked });
step = input<number>(1);
min = input<number>(-Infinity);
max = input<number>(Infinity);
hovering = signal(false);

constructor() {
  console.log("hello from rozie");
}

canIncrement = computed(() => this.value() + this.step() <= this.max());
canDecrement = computed(() => this.value() - this.step() >= this.min());

increment = () => {
  if (this.canIncrement()) this.value.set(this.value() + this.step());
};
decrement = () => {
  if (this.canDecrement()) this.value.set(this.value() - this.step());
};