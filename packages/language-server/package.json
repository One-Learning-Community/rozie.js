{
  "name": "@rozie/language-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "rozie-language-server": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "build:standalone": "tsdown --config tsdown.standalone.config.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "survey": "tsdown && node scripts/survey.mjs"
  },
  "dependencies": {
    "@rozie/core": "workspace:*",
    "@volar/language-core": "2.4.28",
    "@volar/language-server": "2.4.28",
    "@volar/language-service": "2.4.28",
    "@volar/typescript": "2.4.28",
    "volar-service-typescript": "0.0.71",
    "typescript": "5.6.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT"
}
