{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"]
  },
  "include": ["*.ts", "probe/**/*.ts", "hosts/**/*.ts"],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
